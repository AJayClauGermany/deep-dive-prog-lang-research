{
 "id": "lean",
 "name": "Lean 4",
 "aliases": [
  "Lean",
  "Lean 4",
  "Lean Theorem Prover"
 ],
 "categories": [
  "general-purpose",
  "functional",
  "proof-assistant"
 ],
 "paradigms": [
  "functional",
  "imperative-monadic",
  "metaprogramming"
 ],
 "typing": [
  "static",
  "strong",
  "dependent",
  "inferred"
 ],
 "first_appeared": 2013,
 "designers": [
  "Leonardo de Moura",
  "Sebastian Ullrich"
 ],
 "summary": "Dependently typed functional programming language and interactive theorem prover based on the calculus of inductive constructions with quotients; Lean 4 is implemented largely in itself, compiles to C, and has a hygienic macro and elaborator extension system used by the mathlib library.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "vendor-specification"
 ],
 "file_extensions": [
  ".lean"
 ],
 "homepage": "https://lean-lang.org/",
 "influenced_by": [
  "rocq",
  "haskell",
  "ml",
  "agda"
 ],
 "level_notes": {
  "1": "The Lean Language Reference (lean-lang.org/doc/reference/latest) is the official reference; there is no standard. The small C++ kernel plus its type theory define what is a valid proof.",
  "0": "leanprover/lean4 contains the C++ kernel (src/kernel), the runtime (src/runtime) and the self-hosted elaborator/compiler in Lean (src/Lean). External kernel checkers (lean4lean, nanoda) exist."
 },
