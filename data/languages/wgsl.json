{
 "id": "wgsl",
 "name": "WGSL",
 "aliases": [
  "WebGPU Shading Language"
 ],
 "categories": [
  "shader-gpu",
  "domain-specific"
 ],
 "paradigms": [
  "imperative",
  "structured"
 ],
 "typing": [
  "static",
  "strong",
  "explicit",
  "inferred-local"
 ],
 "first_appeared": 2021,
 "designers": [
  "W3C GPU for the Web Working Group (editors: Alan Baker, Mehmet Oguz Derin, David Neto)"
 ],
 "summary": "The shading language of WebGPU, specified by the W3C GPU for the Web group: a Rust-flavoured, statically typed language for vertex, fragment and compute shaders with explicit address spaces, a uniformity analysis and a tightly defined behaviour for portability across Vulkan, Metal and Direct3D 12.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C WebGPU Shading Language (Candidate Recommendation)"
 ],
 "file_extensions": [
  ".wgsl"
 ],
 "homepage": "https://www.w3.org/TR/WGSL/",
 "influenced_by": [
  "spir-v",
  "glsl",
  "hlsl",
  "rust",
  "metal-shading-language"
 ],
 "related": [
  {
   "id": "spir-v",
   "relation": "compiles-to"
  },
  {
   "id": "glsl",
   "relation": "family"
  },
  {
   "id": "hlsl",
   "relation": "family"
  },
  {
   "id": "metal-shading-language",
   "relation": "compiles-to"
  }
 ],
 "level_notes": {
  "1": "The W3C WGSL specification is normative; deep links point at the editor's draft (gpuweb.github.io/gpuweb/wgsl/), whose section ids match the TR snapshot (www.w3.org/TR/ reports 403 to automated checkers). Language changes go through WebGPU extension proposals in gpuweb/gpuweb.",
  "0": "Two major independent implementations: Tint (Google Dawn, Chromium) and naga (wgpu, Firefox). Both translate WGSL to SPIR-V, MSL, HLSL and GLSL. The WebGPU CTS contains the shader conformance tests."
 },
