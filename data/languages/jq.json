{
 "id": "jq",
 "name": "jq",
 "categories": [
  "query",
  "functional",
  "domain-specific",
  "scripting"
 ],
 "paradigms": [
  "functional",
  "declarative",
  "stream-processing"
 ],
 "typing": [
  "dynamic"
 ],
 "first_appeared": 2012,
 "designers": [
  "Stephen Dolan"
 ],
 "summary": "Lightweight functional language and command-line processor for JSON: programs are filters that map an input value to a stream of outputs, composed with pipes and commas, with backtracking generators, path expressions, reduce/foreach, user-defined functions and modules.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "informal"
 ],
 "file_extensions": [
  ".jq"
 ],
 "homepage": "https://jqlang.org/",
 "influenced_by": [
  "icon",
  "haskell"
 ],
 "related": [
  {
   "id": "json",
   "relation": "family"
  },
  {
   "id": "jsonpath",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "No standard. The jq Manual (generated from docs/content/manual/manual.yml) is the de-facto definition; Michael Färber's 'A formal specification of the jq language' (2024) gives a denotational semantics. Release notes (NEWS.md) document version changes.",
  "2": "GitHub wiki pages (jq Language Description, internals) are linked via github.com and checked as repo-only."
 },
