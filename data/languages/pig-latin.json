  ".pig"
 ],
 "homepage": "https://pig.apache.org/",
 "influenced_by": [
  "sql"
 ],
 "level_notes": {
  "0": "Apache Pig (Java) is the only implementation; the ANTLR 3 grammars QueryLexer.g/QueryParser.g and the logical plan operators are the most instructive files.",
  "1": "Defined by the Pig Latin Basics reference manual and the SIGMOD 2008 paper by Olston et al. (paywalled at ACM; no stable open copy verified)."
 },
