   "relation": "superset-of"
  },
  {
   "id": "markdown",
   "relation": "dialect-of"
  },
  {
   "id": "html",
   "relation": "compiles-to"
  }
 ],
 "level_notes": {
  "0": "cmark-gfm is GitHub's reference implementation; the GFM spec examples are its tests.",
  "1": "The GFM spec covers the syntax; github.com-specific rendering (mentions, math, Mermaid, alerts) is only described in GitHub Docs.",
  "3": "PLDB has no separate GFM entry."
 },
