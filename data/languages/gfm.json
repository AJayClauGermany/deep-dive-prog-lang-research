 ],
 "summary": "The Markdown dialect used on GitHub: since 2017 formally specified as a strict superset of CommonMark adding tables, task list items, strikethrough, extended autolinks and a raw-HTML tag filter, implemented by cmark-gfm. github.com additionally renders mentions, issue references, math and diagrams.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "standards": [
  "GFM Spec 0.29-gfm"
 ],
 "file_extensions": [
  ".md"
 ],
 "homepage": "https://github.github.com/gfm/",
 "influenced_by": [
