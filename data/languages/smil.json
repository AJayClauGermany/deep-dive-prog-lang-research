 ],
 "first_appeared": 1998,
 "designers": [
  "W3C SYMM Working Group",
  "Dick Bulterman",
  "Philipp Hoschka"
 ],
 "summary": "W3C XML language for interactive multimedia presentations: <par>, <seq> and <excl> time containers schedule media objects, while layout regions, <switch>/test attributes, hyperlinks, transitions, animation and a state module (variables and XPath expressions) complete the language. Its animation module lives on in SVG.",
 "status": "historical",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "SMIL 1.0 (W3C REC 1998)",
  "SMIL 2.1 (W3C REC 2005)",
  "SMIL 3.0 (W3C REC 2008)"
 ],
 "file_extensions": [
  ".smil",
  ".smi"
 ],
 "homepage": "https://www.w3.org/AudioVideo/",
 "influenced_by": [
  "xml",
  "html"
 ],
