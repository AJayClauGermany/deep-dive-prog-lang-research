  {
   "id": "xml",
   "relation": "dialect-of"
  },
  {
   "id": "svg",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "SMIL 3.0 (W3C Recommendation, multi-page) is the latest version; chapters are deep-linked.",
  "0": "The Ambulant player (CWI) is the open reference-quality SMIL 3.0 player; Gecko's dom/smil implements SMIL animation for SVG."
 },
