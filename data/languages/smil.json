{
 "id": "smil",
 "name": "SMIL",
 "aliases": [
  "Synchronized Multimedia Integration Language"
 ],
 "categories": [
  "markup",
  "domain-specific"
 ],
 "paradigms": [
  "declarative markup",
  "temporal composition"
 ],
 "typing": [
