{
 "id": "rego",
 "name": "Rego (Open Policy Agent policy language)",
 "aliases": [
  "Rego",
  "OPA Rego"
 ],
 "categories": [
  "policy",
  "query",
  "domain-specific"
 ],
 "paradigms": [
  "declarative",
  "logic (Datalog-inspired)"
 ],
 "typing": [
  "dynamic",
  "json values",
  "optional schema-based type checking"
 ],
 "first_appeared": 2016,
 "designers": [
  "Tim Hinrichs",
  "Torin Sandall",
  "Styra"
 ],
 "summary": "Declarative, Datalog-inspired query language of the Open Policy Agent (CNCF) for writing policies over JSON-structured data: rules (complete, partial set/object, functions, defaults, else-chains) are defined by bodies of expressions with unification, references, comprehensions, negation, 'some'/'every' quantifiers and a large built-in library; evaluation is top-down.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "vendor-specification"
 ],
 "standards": [
  "Rego v1 (OPA 1.0, 2024)"
 ],
 "file_extensions": [
  ".rego"
 ],
 "homepage": "https://www.openpolicyagent.org/docs/policy-language",
 "influenced_by": [
  "datalog"
 ],
 "related": [
  {
   "id": "datalog",
   "relation": "variant-of"
  },
  {
   "id": "cedar",
   "relation": "family"
  },
  {
   "id": "cel",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "No independent specification: the OPA documentation's Policy Language and Policy Reference pages (with an EBNF grammar) describe the language, and OPA's implementation is the definition. OPA 1.0 made the 'rego.v1' keywords (if, contains) mandatory.",
  "0": "open-policy-agent/opa (Go) is the reference implementation (ast parser/compiler/type checker, topdown evaluator); Microsoft's Regorus is an independent Rust interpreter.",
  "3": "No Wikipedia or PLDB article; the OPA Playground is the main interactive resource."
 },
