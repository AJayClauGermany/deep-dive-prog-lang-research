 ],
 "summary": "The extended Markdown dialect read and written by Pandoc: adds metadata blocks, rich tables, definition and example lists, footnotes, citations, TeX math, attributes, fenced divs and bracketed spans, with individually toggleable extensions; documents map onto Pandoc's typed AST for conversion to many formats.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "informal"
 ],
 "file_extensions": [
  ".md",
  ".markdown"
 ],
 "homepage": "https://pandoc.org/MANUAL.html#pandocs-markdown",
