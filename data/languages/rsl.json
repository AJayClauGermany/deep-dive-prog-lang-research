  "Søren Prehn",
  "Anne E. Haxthausen",
  "Klaus Havelund"
 ],
 "summary": "The wide-spectrum formal specification language of the RAISE method (Rigorous Approach to Industrial Software Engineering), descended from VDM: it supports applicative and imperative, sequential and concurrent (CSP-style channel) specification styles, axiomatic and model-oriented definitions, and parameterised modules (schemes and objects).",
 "status": "historical",
 "defined_by": [
  "vendor-specification",
  "academic-paper"
 ],
 "file_extensions": [
  ".rsl"
 ],
 "homepage": "https://raisetools.github.io/",
 "influenced_by": [
  "vdm",
  "csp",
  "obj",
  "standard-ml",
  "larch"
 ],
 "related": [
  {
   "id": "vdm",
   "relation": "successor-of"
  },
  {
   "id": "csp",
   "relation": "embeds"
  }
 ],
 "level_notes": {
  "1": "Defined by the book 'The RAISE Specification Language' (Prentice Hall, 1992), whose CRI A/S edition is freely available; Part II is the syntax and semantics reference description. Section links use #page=N (PDF page = printed page + 20). A formal (denotational/axiomatic) semantics was produced in the RAISE project but is not online.",
  "0": "rsltc, the RAISE tool developed at UNU-IIST by Chris George (type checker, pretty-printer, translators to SML/C++, PVS and SAL), is open source on GitHub."
 },
