  "id": "clojure",
  "name": "Clojure",
  "aliases": [
    "Clojure JVM"
  ],
  "categories": [
    "general-purpose",
    "functional"
  ],
  "paradigms": [
    "functional",
    "concurrent",
    "meta"
  ],
  "typing": [
    "dynamic",
    "strong",
    "optional-hints"
  ],
  "first_appeared": 2007,
  "designers": [
    "Rich Hickey"
  ],
  "summary": "Hosted Lisp dialect for the JVM emphasising immutable persistent data structures, managed reference types (atoms, refs/STM, agents), protocols and multimethods, and seamless Java interop.",
  "status": "active",
  "defined_by": [
    "reference-implementation",
    "vendor-specification"
  ],
  "file_extensions": [
    ".clj",
    ".cljc",
    ".edn"
  ],
  "homepage": "https://clojure.org/",
  "influenced_by": [
    "lisp",
    "common-lisp",
    "scheme",
    "haskell",
    "java",
    "erlang"
  ],
  "related": [
    {
      "id": "lisp",
      "relation": "dialect-of"
    },
    {
      "id": "clojurescript",
      "relation": "family"
    },
    {
      "id": "jvm-bytecode",
      "relation": "compiles-to"
    },
    {
      "id": "java",
      "relation": "implemented-in"
    }
  ],
  "level_notes": {
    "1": "No formal standard. The clojure.org Reference pages and API docs plus the reference implementation define the language; changes go through Rich Hickey and the core team (JIRA tickets, no public RFC process). Hickey's HOPL IV paper is the defining retrospective.",
    "0": "clojure/clojure (Java + Clojure) is the reference implementation; ClojureCLR, babashka/SCI and jank are alternatives. ClojureScript has its own entry."
  },
