{
 "id": "befunge",
 "name": "Befunge / Funge-98",
 "categories": [
  "esoteric",
  "visual",
  "concatenative"
 ],
 "aliases": [
  "Befunge-93",
  "Befunge-98",
  "Funge-98",
  "Unefunge",
  "Trefunge"
 ],
 "paradigms": [
  "two-dimensional",
  "stack-based",
  "self-modifying",
  "concurrent"
 ],
 "typing": [
  "untyped"
 ],
 "first_appeared": 1993,
 "designers": [
  "Chris Pressey"
 ],
 "summary": "Two-dimensional stack-based language created by Chris Pressey in 1993 to be hard to compile: the instruction pointer moves across a toroidal grid and programs can rewrite themselves with g/p. Funge-98 generalises it to 1-3 dimensions with unbounded space, a stack of stacks, concurrency and fingerprint extensions.",
 "status": "esoteric",
 "defined_by": [
  "community-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".bf",
  ".b93",
  ".b98"
 ],
 "homepage": "https://github.com/catseye/Befunge-93",
 "influenced_by": [
  "forth",
  "false"
 ],
 "related": [
  {
   "id": "seed",
   "relation": "host-of"
  },
  {
   "id": "snusp",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "Befunge-93 is defined by Pressey's documentation; Funge-98 by the 1998 Final Specification (authored by Pressey with the Befunge mailing list) plus the Cat's Eye fingerprint library. No formal semantics.",
  "0": "bef.c is the Befunge-93 reference; for Funge-98 cfunge and CCBI are the most conforming implementations, with Mycology as the de-facto conformance suite.",
  "2": "Little tutorial literature beyond the specs; write-ups and IDEs listed.",
  "3": "Esolangs, Wikipedia, PLDB, Rosetta Code."
 },
