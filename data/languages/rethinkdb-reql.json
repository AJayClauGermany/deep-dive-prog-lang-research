 "first_appeared": 2012,
 "designers": [
  "RethinkDB team",
  "Slava Akhmechet",
  "Michael Glukhovsky"
 ],
 "summary": "RethinkDB's query language, embedded in host languages as chainable method calls (r.table('users').filter(...).orderBy(...)) that build a term tree serialised as JSON over the wire; queries are functional, composable and lazily evaluated on the server, with joins, map-reduce, grouping and real-time changefeeds.",
 "status": "maintained",
 "defined_by": [
  "reference-implementation",
  "vendor-specification"
 ],
 "homepage": "https://rethinkdb.com/api/javascript/",
 "level_notes": {
  "1": "The per-language API references (JavaScript, Python, Ruby, Java) define the term set; ql2.proto is the normative term/wire definition used by all drivers. RethinkDB is now a Linux Foundation community project.",
  "0": "rethinkdb/rethinkdb (C++) evaluates the term tree in src/rdb_protocol; drivers (e.g. rethinkdb-python's ast.py) build terms client-side."
 },
