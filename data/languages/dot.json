{
 "id": "dot",
 "name": "DOT (Graphviz)",
 "aliases": [
  "DOT language",
  "Graphviz DOT",
  "gv"
 ],
 "categories": [
  "diagram",
  "domain-specific"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "untyped"
 ],
 "first_appeared": 1991,
 "designers": [
  "Emden R. Gansner",
  "Eleftherios Koutsofios",
  "Stephen C. North"
 ],
 "summary": "Plain-text graph description language of Graphviz (AT&T Bell Labs): graphs, digraphs, subgraphs and clusters of nodes and edges carrying key=value attributes, laid out automatically by engines such as dot, neato, fdp and sfdp. The de-facto interchange format for graph drawing.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".gv",
  ".dot"
 ],
 "homepage": "https://graphviz.org/",
 "related": [
  {
   "id": "plantuml",
   "relation": "family"
  },
  {
   "id": "d2",
   "relation": "family"
  }
 ],
 "level_notes": {
  "0": "Graphviz (C, GitLab) is the reference implementation: lib/cgraph holds the flex/bison DOT lexer/parser and graph model, lib/common the attribute handling, shapes and HTML-like labels, and lib/*gen the layout engines. Viz.js/@hpcc-js/wasm compile it to WebAssembly; independent DOT parsers exist in pydot, Gonum and tree-sitter.",
  "1": "The 'DOT Language' page is the grammar and semantics; attributes, attribute types, shapes, arrows and colors are separate reference pages, one URL per attribute.",
  "2": "The designers' user guides (dotguide, neatoguide) and the original layout papers explain the language and its algorithms.",
  "3": "Wikipedia and PLDB."
 },
