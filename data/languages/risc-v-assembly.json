{
 "id": "risc-v-assembly",
 "name": "RISC-V",
 "aliases": [
  "RISC-V assembly",
  "RV32I",
  "RV64GC"
 ],
 "categories": [
  "assembly"
 ],
 "paradigms": [
  "imperative",
  "load-store"
 ],
 "typing": [
  "untyped"
 ],
 "first_appeared": 2010,
 "designers": [
  "Krste Asanović",
  "Andrew Waterman",
  "Yunsup Lee",
  "David Patterson"
 ],
 "summary": "Open, royalty-free modular RISC instruction set architecture from UC Berkeley, now governed by RISC-V International: small RV32I/RV64I base integer ISAs plus standard extensions (M, A, F, D, C, V, B, ...), with a GNU-style assembly language defined by the community assembler manual and the ELF psABI.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "RISC-V Unprivileged ISA 20191213 / 20240411",
  "RISC-V Privileged Architecture"
 ],
 "file_extensions": [
  ".s",
  ".S"
 ],
 "homepage": "https://riscv.org/",
 "influenced_by": [
  "mips-assembly",
  "dlx"
 ],
 "related": [],
 "level_notes": {
  "1": "The ISA manuals (ratified by RISC-V International) define the machine; the docs.riscv.org deep links point at the 20260120 build of the manual. Assembly syntax and the calling convention are specified separately (riscv-asm-manual, riscv-elf-psabi-doc). The RVWMO memory model has Alloy/herd/operational formalisations, and Sail RISC-V is the official formal model.",
  "0": "Sail RISC-V is the golden reference model; Spike is the reference ISA simulator; QEMU, GNU as and LLVM's integrated assembler are the main production implementations."
 },
