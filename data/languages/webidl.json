{
 "id": "webidl",
 "name": "Web IDL",
 "aliases": [
  "WebIDL",
  "Web Interface Definition Language"
 ],
 "categories": [
  "schema-idl"
 ],
 "paradigms": [
  "declarative",
  "object-oriented"
 ],
 "typing": [
  "static",
  "nominal interfaces",
  "structural dictionaries"
 ],
 "first_appeared": 2007,
 "designers": [
  "Cameron McCormack",
  "Boris Zbarsky",
  "Tobie Langel",
  "WHATWG"
 ],
 "summary": "Interface definition language used by web platform specifications to describe the APIs browsers expose to JavaScript: interfaces, mixins, namespaces, dictionaries, enums, callbacks and typedefs over a fixed set of IDL types, with a normative JavaScript binding that defines type conversions, overload resolution and object creation.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "WHATWG Web IDL Living Standard",
  "W3C WebIDL Level 1 (2016, superseded)"
 ],
 "file_extensions": [
  ".webidl",
  ".idl"
 ],
 "homepage": "https://webidl.spec.whatwg.org/",
 "influenced_by": [
  "omg-idl"
 ],
 "related": [
  {
   "id": "omg-idl",
   "relation": "family"
  },
  {
   "id": "javascript",
   "relation": "host-of"
  }
 ],
 "level_notes": {
  "1": "WHATWG Living Standard (since 2021; previously a W3C spec). The grammar is an LL(1) grammar in the spec; the 'JavaScript binding' section is normative for browser behaviour.",
  "0": "webidl2.js is the standard JavaScript parser used by spec tooling and WPT; browsers have their own IDL compilers (Gecko's WebIDL.py, Blink's bindings generator); jsdom's webidl2js and webidl-conversions implement the JS binding."
 },
