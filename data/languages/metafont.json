 ],
 "categories": [
  "domain-specific",
  "document-typesetting"
 ],
 "paradigms": [
  "declarative",
  "imperative",
  "macro"
 ],
 "typing": [
  "dynamic"
 ],
 "first_appeared": 1979,
 "designers": [
  "Donald E. Knuth"
 ],
 "summary": "Knuth's language for describing typeface shapes as programs: pens drawn along cubic-spline paths, linear equations solved implicitly among numeric, pair and transform variables, and a TeX-like macro expansion layer (def/vardef/primarydef) over a small type system (numeric, pair, path, pen, picture, transform, boolean, string). The interpreter, written in WEB, rasterises to GF bitmap fonts; MetaPost is its PostScript/SVG-emitting descendant.",
 "status": "maintained",
 "defined_by": [
  "reference-implementation",
  "academic-paper"
 ],
 "file_extensions": [
  ".mf"
 ],
 "homepage": "https://ctan.org/pkg/metafont",
