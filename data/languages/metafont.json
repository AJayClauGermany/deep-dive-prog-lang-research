   "id": "tex",
   "relation": "family"
  },
  {
   "id": "metapost",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "The METAFONTbook (Computers & Typesetting vol. C, Addison-Wesley 1986) is the language manual; it is not freely online."
 },
