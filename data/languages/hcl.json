 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "dynamic",
  "structural"
 ],
 "first_appeared": 2014,
 "designers": [
  "Mitchell Hashimoto",
  "Martin Atkins (HCL2)",
  "HashiCorp"
 ],
 "summary": "Block-and-attribute configuration language from HashiCorp with an expression sub-language (templates, for expressions, splats, functions) over a cty type system; used by Terraform, Nomad, Packer, Vault and Consul. Has a native syntax and an equivalent JSON syntax.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".hcl",
  ".tf",
  ".nomad",
  ".pkr.hcl"
 ],
 "homepage": "https://github.com/hashicorp/hcl",
