{
 "id": "ttcn-3",
 "name": "TTCN-3",
 "aliases": [
  "Testing and Test Control Notation version 3",
  "TTCN"
 ],
 "categories": [
  "specification-modeling",
  "domain-specific",
  "protocol"
 ],
 "paradigms": [
  "imperative",
  "concurrent",
  "test-description"
 ],
 "typing": [
  "static",
  "strong"
 ],
 "first_appeared": 2000,
 "designers": [
  "ETSI MTS technical committee",
  "ITU-T SG17"
 ],
 "summary": "ETSI's standardized language for specifying and executing black-box conformance and interoperability tests, especially for telecommunication protocols: modules declare ASN.1-compatible types, message/procedure ports, test components and templates with powerful matching, and test cases whose alt statements react to messages and timers and set verdicts.",
 "status": "active",
 "defined_by": [
  "international-standard"
 ],
 "standards": [
  "ETSI ES 201 873-1 (core language)",
  "ETSI ES 201 873-2..11 (presentation formats, runtime/control interfaces, ASN.1/IDL/XSD/JSON mappings)",
  "ITU-T Z.161"
 ],
 "file_extensions": [
  ".ttcn",
  ".ttcn3",
  ".ttcnpp"
 ],
 "homepage": "https://ttcn-3.etsi.org/",
 "influenced_by": [
  "asn1"
 ],
 "related": [
  {
   "id": "asn1",
   "relation": "embeds"
  }
 ],
 "level_notes": {
  "1": "The multi-part ETSI ES 201 873 series is freely downloadable from etsi.org and also published as ITU-T Z.161 ff. Section links use #page=N into the core-language PDF V4.17.1 (PDF page = printed page).",
  "0": "Eclipse Titan (Ericsson-originated, open source; moved from GitHub to gitlab.eclipse.org) is the main open implementation: a TTCN-3-to-C++ compiler with runtime. gitlab.eclipse.org rate-limits automated checkers (429); file paths were confirmed through the /-/raw/ endpoint.",
  "3": "No PLDB entry was found."
 },
