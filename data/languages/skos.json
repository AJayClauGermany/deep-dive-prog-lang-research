  {
   "id": "rdf",
   "relation": "family"
  },
  {
   "id": "owl",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "The SKOS Reference (W3C Recommendation) defines the vocabulary with formal class/property definitions and integrity conditions; the RDF namespace document is normative alongside it. SKOS is a vocabulary rather than a syntax: data is written in any RDF syntax.",
  "0": "There is no reference implementation; Skosify validates/cleans SKOS vocabularies, Skosmos publishes them, and generic RDF/OWL toolkits handle SKOS data.",
  "3": "No PLDB entry exists."
 },
