 "summary": "W3C RDF vocabulary (an OWL Full ontology) for representing thesauri, classification schemes, taxonomies and subject-heading systems: concepts in concept schemes with preferred/alternative/hidden labels, notations, documentation notes, broader/narrower/related semantic relations, collections and cross-scheme mapping properties; SKOS-XL reifies labels.",
 "status": "maintained",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C SKOS Reference (Recommendation, 2009)"
 ],
 "file_extensions": [
  ".ttl",
  ".rdf"
 ],
 "homepage": "https://www.w3.org/2004/02/skos/",
 "influenced_by": [
  "rdf",
  "owl",
  "rdfs"
 ],
