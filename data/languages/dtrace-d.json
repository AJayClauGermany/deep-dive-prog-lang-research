  },
  {
   "id": "systemtap",
   "relation": "family"
  }
 ],
 "level_notes": {
  "0": "illumos libdtrace (compiler) and the kernel DIF virtual machine; also Oracle's DTrace for Linux and FreeBSD/macOS ports.",
  "1": "The Dynamic Tracing Guide (Sun, now hosted by illumos) is the de facto language reference; the USENIX 2004 paper is the defining paper.",
  "2": "Brendan Gregg's books.",
  "3": "Wikipedia."
 },
