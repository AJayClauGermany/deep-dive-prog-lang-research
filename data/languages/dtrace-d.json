 ],
 "summary": "C-like, awk-inspired language for DTrace dynamic tracing: programs are probe clauses (provider:module:function:name /predicate/ { actions }) with C types and operators, thread-local and clause-local variables, associative arrays and aggregations, compiled to safe DIF bytecode executed in the kernel. No loops by design.",
 "status": "maintained",
 "defined_by": [
  "reference-implementation",
  "vendor-specification"
 ],
