{
 "id": "shex",
 "name": "ShEx (Shape Expressions)",
 "aliases": [
  "ShEx",
  "ShExC",
  "ShExJ",
  "Shape Expressions Language 2.1"
 ],
 "categories": [
  "schema-idl",
  "grammar-notation"
 ],
 "paradigms": [
  "declarative",
  "grammar-based"
 ],
 "typing": [
  "structural shapes over RDF graphs",
  "regular bag expressions"
 ],
 "first_appeared": 2014,
 "designers": [
  "Eric Prud'hommeaux",
  "Jose Emilio Labra Gayo",
  "Iovka Boneva",
  "Harold Solbrig"
 ],
 "summary": "Grammar-like schema language for RDF graphs: shapes combine node constraints (node kind, datatype, value sets, facets) and triple expressions (EachOf, OneOf, cardinalities over predicates) with references, recursion, negation, imports, annotations and semantic actions; has compact (ShExC), JSON (ShExJ) and RDF (ShExR) syntaxes.",
 "status": "active",
 "defined_by": [
  "community-specification",
  "academic-paper"
 ],
 "standards": [
  "Shape Expressions Language 2.1 (W3C Community Group final report, 2019)",
  "ShEx 2.0 W3C Member Submission"
 ],
 "file_extensions": [
  ".shex",
  ".shexj"
 ],
 "homepage": "https://shex.io/",
 "influenced_by": [
  "relax-ng",
  "rdf",
  "turtle"
 ],
 "related": [
  {
   "id": "shacl",
   "relation": "family"
  },
  {
   "id": "rdf",
   "relation": "family"
  },
  {
   "id": "relax-ng",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "Specified by the W3C Shape Expressions Community Group (not a W3C Recommendation; an IEEE/W3C standardisation effort is ongoing). The formal semantics was published by Boneva, Labra Gayo and Prud'hommeaux.",
  "0": "shexTest is the official test suite; shex.js (JavaScript, by the editors), PyShEx (Python) and rudof (Rust) are implementations."
 },
