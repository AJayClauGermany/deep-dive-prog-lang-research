{
 "id": "plankalkul",
 "name": "Plankalkül",
 "aliases": [
  "Plankalkuel",
  "Plan Calculus"
 ],
 "categories": [
  "general-purpose",
  "historical"
 ],
 "paradigms": [
  "imperative",
  "procedural"
 ],
 "typing": [
  "static"
 ],
 "first_appeared": 1948,
 "designers": [
  "Konrad Zuse"
 ],
 "summary": "Konrad Zuse's 1942-45 high-level notation for his Z-series computers, with hierarchical bit-based data types (arrays, tuples/records), assignment, guarded conditionals, iteration, assertions and subroutines in a two-dimensional notation; first published in 1948 and fully in 1972, and first implemented decades later.",
 "status": "historical",
 "defined_by": [
  "academic-paper"
 ],
 "level_notes": {
  "1": "The only definition is Zuse's own 1945 manuscript (published 1972 as GMD Bericht 63, English translation GMD Bericht 106); no open scan of either is available, so the original notation is accessed via Bauer & Wössner (1972) and Knuth & Trabb Pardo (1976). Level 1 therefore has no linkable entry.",
  "0": "Zuse never implemented it. Implementations: Hohmann (1975 dissertation, not available), FU Berlin compiler (Rojas et al., 2000; report record linked), and a 2025 Python interpreter on GitHub/PyPI using a linearized notation. Line anchors refer to the main branch.",
  "2": "Secondary literature is mainly historical papers and student theses.",
  "3": "Encyclopedic coverage only (Wikipedia en/de, PLDB)."
 },
