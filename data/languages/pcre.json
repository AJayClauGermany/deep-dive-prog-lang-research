 "designers": [
  "Philip Hazel",
  "Larry Wall"
 ],
 "summary": "The Perl regular-expression dialect and the PCRE/PCRE2 C library that re-implements it: backtracking matching with lazy and possessive quantifiers, atomic groups, lookahead/lookbehind, named groups, recursion and subroutine calls, conditionals, backtracking-control verbs and Unicode properties; the de-facto syntax of many languages' regex engines.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "informal"
 ],
