   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "No standard: Perl's perlre is the original definition and PCRE2's pcre2pattern/pcre2syntax man pages document the library dialect (pcre2compat lists the differences). Deep links use the man pages' named anchors where present.",
  "0": "PCRE2 (C; interpretive backtracking matcher, alternative DFA matcher and an SLJIT-based JIT) and Perl's own regcomp.c/regexec.c."
 },
