{
 "id": "xdr",
 "name": "XDR (RFC 4506)",
 "aliases": [
  "External Data Representation",
  "Sun XDR"
 ],
 "categories": [
  "data-serialization",
  "schema-idl"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "static",
  "schema-required"
 ],
 "first_appeared": 1987,
 "designers": [
  "Sun Microsystems"
 ],
 "summary": "Sun's big-endian, 4-byte-aligned binary encoding and accompanying C-like data description language, used by ONC RPC, NFS and Stellar; data is not self-describing and must be decoded against the XDR type declarations.",
 "status": "maintained",
 "defined_by": [
  "international-standard"
 ],
 "standards": [
  "RFC 4506 (STD 67)",
  "RFC 1832",
  "RFC 1014"
 ],
 "file_extensions": [
  ".x"
 ],
 "homepage": "https://www.rfc-editor.org/rfc/rfc4506.html",
 "influenced_by": [
  "c"
 ],
 "related": [
  {
   "id": "asn1",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "RFC 4506 (STD 67) defines both the encoding and the XDR language (Section 6); it supersedes RFC 1832 and RFC 1014. RFC 5531 (ONC RPC) extends the language with program/version/procedure definitions.",
  "0": "The original Sun RPC code survives in glibc/libtirpc (xdr.c primitives) and the rpcgen compiler; other implementations include Python's former xdrlib and Go's go-xdr.",
  "2": "Secondary literature is mostly ONC RPC / rpcgen programming guides in vendor manuals; the Python library reference is the closest maintained tutorial-style text."
 },
