{
 "id": "fdr-cspm",
 "name": "CSPM (FDR)",
 "aliases": [
  "CSP-M",
  "Machine-readable CSP",
  "CSPm"
 ],
 "categories": [
  "specification-modeling"
 ],
 "paradigms": [
  "process-algebra",
  "functional",
  "concurrent"
 ],
 "typing": [
  "static",
  "inferred",
  "polymorphic"
 ],
 "first_appeared": 1992,
 "designers": [
  "Bryan Scattergood",
  "A. W. Roscoe",
  "Thomas Gibson-Robinson"
 ],
 "summary": "The machine-readable dialect of Hoare's CSP process algebra used by the FDR refinement checker and ProB: a lazy, typed functional expression language (sets, sequences, maps, datatypes, channels) combined with CSP process operators and refinement assertions checked by FDR.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".csp"
 ],
 "homepage": "https://cocotec.io/fdr/",
 "influenced_by": [
  "csp",
  "haskell"
 ],
 "related": [
  {
   "id": "csp",
   "relation": "dialect-of"
  }
 ],
 "level_notes": {
  "1": "No standard; the CSPM chapter of the FDR4 manual (Cocotec / Oxford) is the de facto definition. Scattergood's 1998 DPhil thesis gave the original semantics.",
  "0": "FDR4 itself is distributed as binaries; its CSPM front end libcspm (Haskell: parser, type checker, evaluator) is open source. ProB implements CSPM independently in Prolog."
 },
