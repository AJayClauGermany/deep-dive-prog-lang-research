{
  "id": "emacs-lisp",
  "name": "Emacs Lisp",
  "aliases": [
    "Elisp",
    "ELisp"
  ],
  "categories": [
    "scripting",
    "domain-specific",
    "functional"
  ],
  "paradigms": [
    "functional",
    "imperative",
    "meta"
  ],
  "typing": [
    "dynamic",
    "strong"
  ],
  "first_appeared": 1985,
  "designers": [
    "Richard Stallman",
    "Guy L. Steele Jr."
  ],
  "summary": "The extension language of GNU Emacs: a MacLisp-derived Lisp with dynamic and (since Emacs 24) lexical binding, buffer-local variables, a bytecode compiler and (since Emacs 28) native compilation via libgccjit.",
  "status": "active",
  "defined_by": [
    "reference-implementation",
    "vendor-specification"
  ],
  "file_extensions": [
    ".el",
    ".elc",
    ".eln"
  ],
  "homepage": "https://www.gnu.org/software/emacs/",
  "influenced_by": [
    "maclisp",
    "common-lisp",
    "lisp"
  ],
  "related": [
    {
      "id": "lisp",
      "relation": "dialect-of"
    },
    {
      "id": "common-lisp",
      "relation": "family"
    },
    {
      "id": "c",
      "relation": "implemented-in"
    }
  ],
  "level_notes": {
    "1": "No standard; the GNU Emacs Lisp Reference Manual (per-node pages linked) and the GNU Emacs implementation define the language. Release notes in etc/NEWS track language changes; the HOPL IV paper by the maintainers is the authoritative history.",
    "0": "The only implementation of note is GNU Emacs (C core in src/, Lisp in lisp/); links use the emacs-mirror/emacs GitHub mirror of savannah emacs.git.",
    "2": "www.gnu.org intermittently drops connections from the research sandbox; manual node names were taken from the manual's own index page."
  },
