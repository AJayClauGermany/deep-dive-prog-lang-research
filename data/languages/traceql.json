  "logql"
 ],
 "level_notes": {
  "1": "Defined by the Tempo documentation (TraceQL pages, sourced from docs/sources/tempo/traceql in the repo) and the goyacc grammar in pkg/traceql; the 2022 design proposal records the intended semantics. The rendered docs carry no static section anchors.",
  "0": "Grafana Tempo (Go) is the only implementation: goyacc grammar expr.y, hand-written lexer, AST and a storage-pushdown engine.",
  "3": "No encyclopedia or catalog entry for TraceQL exists (no Wikipedia article, not in PLDB)."
 },
