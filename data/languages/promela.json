{
 "id": "promela",
 "name": "Promela (SPIN)",
 "aliases": [
  "Promela",
  "Process Meta Language",
  "SPIN"
 ],
 "categories": [
  "specification-modeling"
 ],
 "paradigms": [
  "concurrent",
  "imperative",
  "guarded-command",
  "message-passing"
 ],
 "typing": [
  "static",
  "weak"
 ],
 "first_appeared": 1980,
 "designers": [
  "Gerard J. Holzmann"
 ],
 "summary": "Process meta-language of the SPIN model checker for describing concurrent and distributed systems as communicating processes with guarded commands, channels (rendezvous and buffered) and never-claims/LTL properties; SPIN translates a model into a C verifier (pan).",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "vendor-specification"
 ],
 "file_extensions": [
  ".pml",
  ".prom"
 ],
 "homepage": "https://spinroot.com/",
 "influenced_by": [
  "guarded-command-language",
  "c"
 ],
 "related": [
  {
   "id": "temporal-logic",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "No standard: Holzmann's online Promela manual pages and grammar on spinroot.com, plus the SPIN book (2003), define the language; the Spin implementation is authoritative in corner cases.",
  "0": "Spin (C, Holzmann; now open source on GitHub) parses Promela with a yacc grammar and generates the pan.c verifier."
 },
