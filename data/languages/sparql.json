{
 "id": "sparql",
 "name": "SPARQL",
 "aliases": [
  "SPARQL Protocol and RDF Query Language"
 ],
 "categories": [
  "query",
  "domain-specific"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "dynamic"
 ],
 "first_appeared": 2008,
 "designers": [
  "W3C RDF Data Access Working Group",
  "Eric Prud'hommeaux",
  "Andy Seaborne"
 ],
 "summary": "W3C query language for RDF graphs: queries match triple/graph patterns with OPTIONAL, UNION, property paths, aggregates and subqueries, returning tables, graphs or booleans; companion specs cover Update, protocol, federation and entailment.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C SPARQL 1.1 (2013)",
  "W3C SPARQL 1.0 (2008)"
 ],
 "file_extensions": [
  ".rq",
  ".ru"
 ],
 "homepage": "https://www.w3.org/TR/sparql11-overview/",
 "influenced_by": [
  "sql",
  "rdql"
 ],
 "level_notes": {
  "1": "SPARQL 1.1 W3C Recommendations (2013) are normative; SPARQL 1.2 is a Working Draft.",
  "0": "Many independent engines; Apache Jena ARQ is the de facto reference used by the editors. W3C rdf-tests holds the conformance suite."
 },
