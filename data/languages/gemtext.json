  }
 ],
 "level_notes": {
  "1": "The gemtext specification (separate from the protocol specification since 2022) is short and includes a formal ABNF grammar; all sections are deep-linked.",
  "0": "No reference implementation; clients such as Amfora and Lagrange contain gemtext renderers."
 },
