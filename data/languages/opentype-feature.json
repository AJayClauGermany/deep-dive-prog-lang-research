{
 "id": "opentype-feature",
 "name": "OpenType feature file language",
 "aliases": [
  "AFDKO feature syntax",
  ".fea"
 ],
 "categories": [
  "domain-specific"
 ],
 "paradigms": [
  "declarative",
  "rule-based"
 ],
 "typing": [
  "untyped"
 ],
 "first_appeared": 1998,
 "designers": [
  "Adobe Systems (Adobe Font Development Kit for OpenType)"
 ],
 "summary": "Adobe's textual language for OpenType Layout tables: feature and lookup blocks containing GSUB substitution and GPOS positioning rules over glyphs and glyph classes, with language-system declarations, mark classes, contextual/chaining rules, value records and anchors; compiled into binary GSUB/GPOS/GDEF tables by makeotf, fontTools feaLib or fea-rs.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".fea"
 ],
 "homepage": "https://adobe-type-tools.github.io/afdko/OpenTypeFeatureFileSpecification.html",
 "level_notes": {
  "2": "Little tutorial literature beyond the spec itself; Simon Cozens' book chapter is the main one.",
  "3": "No Wikipedia article or PLDB entry covers the feature-file language itself."
 },
