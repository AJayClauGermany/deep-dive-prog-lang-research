{
 "id": "make",
 "name": "Make (POSIX and GNU)",
 "aliases": [
  "make",
  "GNU Make",
  "gmake",
  "BSD make",
  "bmake",
  "Makefile"
 ],
 "categories": [
  "build",
  "domain-specific"
 ],
 "paradigms": [
  "declarative",
  "rule-based",
  "dependency-driven"
 ],
 "typing": [
  "untyped-strings"
 ],
 "first_appeared": 1976,
 "designers": [
  "Stuart Feldman",
  "Richard Stallman",
  "Roland McGrath",
  "Paul D. Smith"
 ],
 "summary": "Rule-based build language: a makefile declares targets, their prerequisites and shell recipes, and make rebuilds what is out of date. POSIX standardises a small core (target rules, macros, inference/suffix rules); GNU Make adds pattern rules, two variable flavours, conditionals, a functional macro language ($(foreach), $(call), $(eval)) and parallel builds; BSD make has its own extensions.",
 "status": "active",
 "defined_by": [
  "international-standard",
  "reference-implementation"
 ],
 "standards": [
  "POSIX.1-2024 (IEEE Std 1003.1-2024) XCU make utility"
 ],
 "file_extensions": [
  "Makefile",
  "makefile",
  "GNUmakefile",
  ".mk",
  ".mak"
 ],
 "homepage": "https://www.gnu.org/software/make/",
 "influenced_by": [],
 "related": [
  {
   "id": "posix-sh",
   "relation": "embeds"
  },
  {
   "id": "autoconf",
   "relation": "family"
  },
  {
   "id": "just",
   "relation": "family"
  }
 ],
 "level_notes": {
  "0": "Implementations: GNU Make (git.savannah.gnu.org/cgit/make.git, the de facto reference for GNU extensions), NetBSD make/bmake (also FreeBSD), OpenBSD make, pdpmake (strict POSIX make), Google kati (GNU-make-compatible, used for Android). Savannah cgit sometimes returns 502 to automated clients.",
  "1": "POSIX XCU 'make' defines the portable core; the GNU Make manual defines GNU Make; BSD make is defined by its make(1) page. Feldman's 1979 paper introduced the language.",
  "2": "Books (Managing Projects with GNU Make, open), Paul Smith's papers, tutorials and the build-systems literature (Recursive/Non-recursive Make Considered Harmful, Build Systems a la Carte).",
  "3": "Wikipedia, PLDB."
 },
