{
 "id": "idris",
 "name": "Idris 2",
 "aliases": ["Idris", "Idris2"],
 "categories": ["general-purpose", "functional", "proof-assistant"],
 "paradigms": ["functional", "dependently-typed"],
 "typing": ["static", "strong", "dependent", "quantitative", "inferred"],
 "first_appeared": 2007,
 "designers": ["Edwin Brady"],
 "summary": "Purely functional programming language with first-class dependent types designed for type-driven development; Idris 2 is self-hosted, based on Quantitative Type Theory (multiplicities 0/1/ω enabling linear and erased arguments) and compiles via Chez Scheme, Racket, JavaScript or C.",
 "status": "active",
 "defined_by": ["reference-implementation", "academic-paper"],
 "file_extensions": [".idr", ".lidr", ".ipkg"],
 "homepage": "https://www.idris-lang.org/",
 "influenced_by": ["haskell", "agda", "epigram", "ml-lcf"],
 "related": [
  {"id": "scheme", "relation": "compiles-to"}
 ],
 "level_notes": {
  "1": "No formal specification. The Idris 2 documentation (tutorial plus language reference) and Brady's papers (Idris 1 JFP 2013; Idris 2 ECOOP 2021) define the language.",
  "0": "idris-lang/Idris2 is the self-hosting compiler: Core/ holds the core type theory (TT), unification, linearity and termination checking; TTImp/ the elaborator; Compiler/ the backends."
 },
