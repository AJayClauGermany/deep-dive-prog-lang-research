 ],
 "level_notes": {
  "0": "The Arizona implementation (version 9.5, C plus the RTL runtime language) is preserved at github.com/gtownsend/icon; Unicon extends the same code base.",
  "1": "No standard; 'The Icon Programming Language' (3rd ed., free PDF) and the Icon reference pages are the definition. The Implementation book documents the virtual machine.",
  "3": "Rosetta Code reports 'blocked' to automated checkers."
 },
