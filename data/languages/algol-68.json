 "designers": ["Adriaan van Wijngaarden", "Barry J. Mailloux", "John E. L. Peck", "Cornelis H. A. Koster", "Michel Sintzoff", "Charles H. Lindsey", "Lambert Meertens", "Richard G. Fisker"],
 "summary": "IFIP WG 2.1's orthogonal successor to ALGOL 60, defined with a two-level van Wijngaarden grammar: everything is an expression, user-defined modes (structural types) and operators, unions, references, flexible rows, coercions, parallel clauses and semaphores. Revived in 2025-26 by the GNU Algol 68 front end in GCC.",
 "status": "maintained",
 "defined_by": ["academic-paper", "consortium-standard"],
 "standards": ["Revised Report on the Algorithmic Language Algol 68 (IFIP WG 2.1, 1975)"],
 "file_extensions": [".a68", ".a68g"],
 "homepage": "https://algol68-lang.org/",
 "influenced_by": ["algol-60"],
 "related": [{"id": "algol-60", "relation": "successor-of"}],
 "level_notes": {"1": "The Revised Report (Acta Informatica 5, 1975; IFIP WG 2.1) is normative and freely available. Its formal definition uses a two-level (van Wijngaarden) grammar. Modern GNU extensions (modules, stropping, short-circuit operators) are published as GNU68 working-group drafts on algol68-lang.org.", "0": "GNU Algol 68 (ga68) is a GCC front end (gcc/algol68, runtime libga68); its parser is derived from Algol 68 Genie (a68g, Marcel van der Veer's interpreter). Historic implementations: ALGOL 68-R, ALGOL 68C, ALGOL 68S, CDC ALGOL 68."},
