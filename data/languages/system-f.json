  "first_appeared": 1971,
  "designers": [
    "Jean-Yves Girard",
    "John C. Reynolds"
  ],
  "summary": "The polymorphic (second-order) typed lambda calculus, discovered independently by Girard (1971/72, as a proof system for second-order arithmetic) and Reynolds (1974, for parametric polymorphism). It adds type abstraction and application to the simply typed lambda calculus; it is strongly normalising, its type inference is undecidable, and it underlies GHC Core, ML polymorphism and the theory of parametricity.",
  "status": "theoretical",
  "defined_by": [
    "academic-paper"
  ],
  "homepage": "https://en.wikipedia.org/wiki/System_F",
  "influenced_by": [
    "simply-typed-lambda-calculus",
    "lambda-calculus"
  ],
