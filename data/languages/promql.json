{
 "id": "promql",
 "name": "PromQL",
 "aliases": [
  "Prometheus Query Language"
 ],
 "categories": [
  "query",
  "domain-specific"
 ],
 "paradigms": [
  "functional",
  "declarative"
 ],
 "typing": [
  "dynamic"
 ],
 "first_appeared": 2015,
 "designers": [
  "Julius Volz",
  "Björn Rabenstein",
  "Prometheus authors"
 ],
 "summary": "Functional query language of the Prometheus monitoring system: label-matching selectors produce instant and range vectors of time series that are combined with vector-matching operators, aggregations and functions such as rate().",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "vendor-specification"
 ],
 "homepage": "https://prometheus.io/docs/prometheus/latest/querying/basics/",
 "level_notes": {
  "1": "No standard; the Prometheus documentation plus the reference engine define PromQL; other systems (Thanos, Cortex/Mimir, VictoriaMetrics) aim for compatibility."
 },
