  "Sanjiva Weerawarana",
  "Roberto Chinnici",
  "Jean-Jacques Moreau",
  "Arthur Ryman"
 ],
 "summary": "XML-based interface definition language for SOAP/HTTP web services: abstract interfaces (portTypes) made of operations exchanging messages typed with XML Schema, bound to concrete protocols and endpoints. WSDL 1.1 (2001 W3C Note, from IBM/Microsoft/Ariba) dominated in practice; WSDL 2.0 became a W3C Recommendation in 2007.",
 "status": "historical",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C Note WSDL 1.1 (2001)",
  "W3C Recommendation WSDL 2.0 (2007)"
 ],
 "file_extensions": [
  ".wsdl"
 ],
 "homepage": "https://www.w3.org/TR/wsdl20/",
 "influenced_by": [
  "xml-schema",
  "omg-idl"
 ],
 "related": [
  {
   "id": "xml-schema",
   "relation": "embeds"
  },
  {
   "id": "openapi",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "WSDL 1.1 is only a W3C Note (submission) but is what SOAP toolkits implement (with WS-I Basic Profile clarifications); WSDL 2.0 Core/Adjuncts are W3C Recommendations with a Z-notation formalisation of the component model.",
  "0": "Implemented by SOAP stacks: Apache CXF (wsdl2java), WSDL4J, Apache Woden (WSDL 2.0), Python zeep."
 },
