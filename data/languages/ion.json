 ],
 "first_appeared": 2016,
 "designers": [
  "Amazon"
 ],
 "summary": "Richly typed, self-describing data format from Amazon with interchangeable text (a JSON superset) and binary encodings; adds arbitrary-precision decimals, timestamps, symbols with symbol tables, blobs/clobs, S-expressions and type annotations.",
 "status": "active",
 "defined_by": [
  "vendor-specification"
 ],
 "standards": [
  "Ion 1.0 specification",
  "Ion 1.1 (draft)"
 ],
 "file_extensions": [
  ".ion",
  ".10n"
 ],
 "homepage": "https://amazon-ion.github.io/ion-docs/",
 "influenced_by": [
  "json",
  "s-expressions"
 ],
 "related": [
  {
   "id": "json",
   "relation": "superset-of"
  },
  {
   "id": "partiql",
   "relation": "host-of"
  }
 ],
 "level_notes": {
  "1": "The Ion 1.0 specification pages on amazon-ion.github.io (data model, text and binary encodings, symbols) are normative; Ion 1.1 (macros, modules) is published as a separate book and is still a draft. Ion Schema is a companion spec.",
  "0": "ion-java is the original implementation; ion-c, ion-python, ion-rust and others follow. amazon-ion/ion-tests is the shared good/bad/equivalence and conformance corpus."
 },
