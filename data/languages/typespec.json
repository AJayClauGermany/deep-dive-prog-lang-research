 "first_appeared": 2022,
 "designers": [
  "Microsoft (Azure API design team)",
  "Brian Terlson"
 ],
 "summary": "TypeScript-inspired API description language from Microsoft for defining data models and service operations (models, scalars, enums, unions, interfaces, operations, templates, decorators, namespaces) that emitters compile to OpenAPI, JSON Schema, Protobuf, client and server code. Formerly called Cadl; 1.0 released in 2025.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "standards": [
  "TypeSpec 1.0 (2025)"
 ],
 "file_extensions": [
  ".tsp"
 ],
 "homepage": "https://typespec.io/",
 "influenced_by": [
  "typescript",
  "openapi"
 ],
