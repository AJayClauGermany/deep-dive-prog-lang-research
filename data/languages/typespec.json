  {
   "id": "openapi",
   "relation": "compiles-to"
  },
  {
   "id": "json-schema",
   "relation": "compiles-to"
  },
  {
   "id": "smithy",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "The 'Language basics' documentation on typespec.io is the de-facto language reference; a formal grammar lives in packages/spec (spec.emu.html, ecmarkup) of the microsoft/typespec repository.",
  "0": "The TypeScript compiler in microsoft/typespec (packages/compiler: scanner, parser, checker) is the only implementation; emitters such as @typespec/openapi3 and @typespec/json-schema are separate packages.",
  "3": "No Wikipedia or PLDB entry exists yet."
 },
