  }
 ],
 "level_notes": {
  "0": "Wikitext is defined by MediaWiki's PHP parser; Parsoid (PEG grammar plus token transformers) is the modern implementation and parserTests.txt the shared test corpus.",
  "1": "No complete specification exists; the mediawiki.org Markup spec and Specs/wikitext pages are partial. Help pages are used as section-level references because MediaWiki section anchors are generated per heading text."
 },
