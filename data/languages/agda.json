{
 "id": "agda",
 "name": "Agda",
 "categories": [
  "functional",
  "proof-assistant"
 ],
 "paradigms": [
  "functional",
  "dependently-typed"
 ],
 "typing": [
  "static",
  "strong",
  "dependent",
  "inferred"
 ],
 "first_appeared": 2007,
 "designers": [
  "Ulf Norell"
 ],
 "summary": "Dependently typed total functional programming language and proof assistant based on Martin-Löf type theory, with dependent pattern matching, mixfix operators, interactive hole-driven development, and extensions such as cubical type theory and sized types.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "academic-paper"
 ],
 "file_extensions": [
  ".agda",
  ".lagda",
  ".lagda.md"
 ],
 "homepage": "https://wiki.portal.chalmers.se/agda/",
 "influenced_by": [
  "haskell",
  "epigram",
  "cayenne",
  "rocq"
 ],
 "related": [
  {
   "id": "haskell",
   "relation": "implemented-in"
  },
  {
   "id": "haskell",
   "relation": "compiles-to"
  },
  {
   "id": "cubical-agda",
   "relation": "host-of"
  }
 ],
 "level_notes": {
  "1": "No formal specification; the Agda documentation's language reference and Norell's 2007 thesis describe the language. Agda 2 is a complete redesign of the earlier Agda/Alfa systems.",
  "0": "The Haskell implementation agda/agda is the definition; the type checker lives under src/full/Agda/TypeChecking, the MAlonzo (GHC) and JS backends under Agda/Compiler."
 },
