{
 "id": "wolfram-language",
 "name": "Wolfram Language",
 "aliases": [
  "Mathematica",
  "Wolfram Mathematica"
 ],
 "categories": [
  "scientific",
  "functional"
 ],
 "paradigms": [
  "term-rewriting",
  "functional",
  "symbolic",
  "procedural"
 ],
 "typing": [
  "dynamic"
 ],
 "first_appeared": 1988,
 "designers": [
  "Stephen Wolfram"
 ],
 "summary": "Proprietary symbolic language of Mathematica (named Wolfram Language in 2013): everything is an expression, evaluated by repeated application of pattern-based transformation rules, with a very large built-in library.",
 "status": "active",
 "defined_by": [
  "vendor-specification"
 ],
 "file_extensions": [
  ".wl",
  ".m",
  ".nb",
  ".wls"
 ],
 "homepage": "https://www.wolfram.com/language/",
 "influenced_by": [
  "lisp",
  "apl",
  "smp",
  "prolog"
 ],
 "level_notes": {
  "0": "Proprietary; Wolfram's kernel source is not available. Level 0 lists Mathics3, an independent open-source (Python) reimplementation of the core language - not the definition and not fully compatible.",
  "1": "No standard; the vendor's Wolfram Language & System Documentation Center (reference pages, guides and tutorials) is the de-facto definition. Wolfram tutorials there are treated as the reference manual's prose sections."
 },
