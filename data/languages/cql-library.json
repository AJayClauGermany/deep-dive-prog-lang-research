 "designers": [
  "ZING / SRU Editorial Board",
  "Library of Congress",
  "OASIS Search Web Services TC"
 ],
 "summary": "Formal query language for information-retrieval systems (library catalogues, digital libraries) used by the SRU and SRW search/retrieve protocols: search clauses of index, relation and term joined by boolean and proximity operators, with modifiers, prefix-qualified context sets and sorting.",
 "status": "maintained",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "OASIS searchRetrieve Version 1.0 Part 5: CQL (2013)",
  "CQL 1.2 (Library of Congress)"
 ],
 "homepage": "https://www.loc.gov/standards/sru/cql/",
 "level_notes": {
  "1": "CQL 1.2 is maintained by the Library of Congress (SRU site); CQL 2.0 is OASIS searchRetrieve Part 5. Context sets (e.g. the CQL context set, Dublin Core) define indexes and relations.",
  "0": "Index Data's cql-java, cql-js and the YAZ toolkit's bison grammar are the commonly used parsers."
 },
