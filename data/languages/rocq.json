{
 "id": "rocq",
 "name": "Rocq (Coq) / Gallina / Ltac",
 "aliases": [
  "Coq",
  "Gallina",
  "Ltac",
  "Ltac2",
  "Rocq Prover"
 ],
 "categories": [
