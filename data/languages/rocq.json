 ],
 "paradigms": [
  "functional",
  "declarative",
  "tactic-based"
 ],
 "typing": [
  "static",
  "strong",
  "dependent",
  "inferred"
 ],
 "first_appeared": 1989,
 "designers": [
  "Thierry Coquand",
  "Gérard Huet",
  "Christine Paulin-Mohring"
 ],
 "summary": "Interactive proof assistant based on the Calculus of Inductive Constructions (formerly Coq, renamed Rocq in 2025). Its specification language Gallina is a dependently typed functional language; proofs are built with the Ltac/Ltac2 tactic languages and checked by a small kernel, and programs can be extracted to OCaml, Haskell or Scheme.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "vendor-specification",
  "academic-paper"
 ],
 "file_extensions": [
  ".v"
 ],
 "homepage": "https://rocq-prover.org/",
 "influenced_by": [
  "ml",
  "automath",
  "lf"
 ],
 "related": [
  {
   "id": "ocaml",
   "relation": "implemented-in"
  },
  {
   "id": "ocaml",
   "relation": "compiles-to"
  }
 ],
 "level_notes": {
  "1": "The Rocq Reference Manual (refman) is the official description; the kernel's type theory (CIC, documented in the refman's 'Typing rules' chapter and in Coquand/Huet and Paulin-Mohring papers) is the logical definition. No standard.",
  "0": "rocq-prover/rocq (OCaml): kernel/ is the trusted checker, pretyping/ the elaborator, parsing/ the camlp5-style grammar (.mlg), plugins/ltac and plugins/ltac2 the tactic languages. The standard library is now in rocq-prover/stdlib."
 },
