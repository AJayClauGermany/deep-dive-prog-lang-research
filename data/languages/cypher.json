{
 "id": "cypher",
 "name": "Cypher / openCypher",
 "aliases": [
  "openCypher",
  "Neo4j Cypher"
 ],
 "categories": [
  "query",
  "domain-specific"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "dynamic"
 ],
 "first_appeared": 2011,
 "designers": [
  "Andrés Taylor",
  "Neo4j"
 ],
 "summary": "Declarative property-graph query language created for Neo4j, built around ASCII-art graph patterns in MATCH, clause pipelines joined by WITH, and MERGE/CREATE/SET updates; openCypher opened it to other vendors and it fed directly into ISO GQL.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "community-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".cypher",
  ".cql"
 ],
 "homepage": "https://opencypher.org/",
 "influenced_by": [
  "sql",
  "sparql"
 ],
 "related": [
  {
   "id": "gql",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "The Neo4j Cypher Manual is the de facto reference; openCypher 9 is the vendor-neutral spec, with CIPs for changes. GQL (ISO/IEC 39075) now standardises the core.",
  "0": "Neo4j is the reference implementation; openCypher TCK (Gherkin scenarios) is the conformance suite; Apache AGE and Memgraph are independent implementations."
 },
