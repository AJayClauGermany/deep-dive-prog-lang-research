{
 "id": "wit",
 "name": "WIT (WebAssembly Interface Types / Component Model IDL)",
 "aliases": [
  "WIT",
  "Wasm Interface Type",
  "WebAssembly Component Model"
 ],
 "categories": [
  "schema-idl"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "static",
  "nominal resources",
  "structural records/variants"
 ],
 "first_appeared": 2022,
 "designers": [
  "Luke Wagner",
  "Alex Crichton",
  "Bytecode Alliance",
  "W3C WebAssembly CG"
 ],
 "summary": "Interface definition language of the WebAssembly Component Model: packages contain interfaces (types and functions) and worlds (sets of imports/exports) using records, variants, enums, flags, options, results, lists, tuples and resource handles; the Canonical ABI defines how these values are lowered to and lifted from core WebAssembly.",
 "status": "active",
 "defined_by": [
  "community-specification",
  "reference-implementation"
 ],
 "standards": [
  "WebAssembly Component Model (W3C WebAssembly CG proposal, phase 1)"
 ],
 "file_extensions": [
  ".wit"
 ],
 "homepage": "https://component-model.bytecodealliance.org/",
 "influenced_by": [
  "webidl",
  "rust"
 ],
 "related": [
  {
   "id": "webassembly",
   "relation": "compiles-to"
  }
 ],
 "level_notes": {
  "1": "Specified by Markdown design documents in the WebAssembly/component-model repository (a W3C WebAssembly Community Group proposal, not yet a W3C standard); CanonicalABI.md is backed by an executable Python reference definition. The earlier 'Interface Types' proposal is superseded.",
  "0": "wit-parser and wit-component in bytecodealliance/wasm-tools are the de-facto reference implementation; wit-bindgen generates guest bindings for many languages."
 },
