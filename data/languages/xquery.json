{
 "id": "xquery",
 "name": "XQuery",
 "aliases": [
  "XML Query"
 ],
 "categories": [
  "query",
  "functional",
  "domain-specific"
 ],
 "paradigms": [
  "declarative",
  "functional"
 ],
 "typing": [
  "static",
  "dynamic",
  "strong",
  "optional-schema-aware"
 ],
 "first_appeared": 2007,
 "designers": [
  "W3C XML Query Working Group",
  "Don Chamberlin",
  "Jonathan Robie",
  "Daniela Florescu",
  "Michael Kay"
 ],
 "summary": "W3C-standardised functional query language over the XQuery and XPath Data Model (XML nodes, atomic values, and since 3.1 maps and arrays/JSON); a superset of XPath with FLWOR expressions, node constructors, modules and higher-order functions. Recommendations 1.0 (2007), 3.0 (2014), 3.1 (2017); 4.0 is drafted by the QT4 Community Group.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C XQuery 1.0",
  "W3C XQuery 3.0",
  "W3C XQuery 3.1"
 ],
 "file_extensions": [
  ".xq",
  ".xquery",
  ".xqm",
  ".xql",
  ".xqy"
 ],
 "homepage": "https://www.w3.org/XML/Query/",
 "influenced_by": [
  "xpath",
  "sql",
  "oql",
  "xslt"
 ],
 "related": [
  {
   "id": "xpath",
   "relation": "superset-of"
  },
  {
   "id": "xquery-update",
   "relation": "host-of"
  },
  {
   "id": "xslt",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "Defined by a family of W3C Recommendations: XQuery 3.1 (language), XPath and XQuery Functions and Operators 3.1, the XQuery and XPath Data Model 3.1, Serialization 3.1, and the (1.0-only) Formal Semantics. www.w3.org returns a Cloudflare 403 to the link checker; all w3.org anchors were verified with a plain curl fetch. XQuery 4.0 drafts live at qt4cg.org.",
  "0": "No single reference implementation; conformance is measured with the W3C QT3 test suite (qt3tests, and qt4tests for 4.0). BaseX (Java), Saxon (Java/C#; Saxon-HE is open source, its repository mainly ships releases), eXist-db (ANTLR grammar), Zorba (C++, dormant) and Galax (OCaml, historical) are representative implementations.",
  "2": "Books: Walmsley's 'XQuery' (O'Reilly); Wadler's typed-functional XQuery tutorial; the Wikibooks XQuery cookbook."
 },
