{
 "id": "solidity",
 "name": "Solidity",
 "categories": [
  "smart-contract",
  "object-oriented"
 ],
 "paradigms": [
  "imperative",
  "object-oriented",
  "contract-oriented"
 ],
 "typing": [
  "static",
  "strong",
  "nominal"
 ],
 "first_appeared": 2015,
 "designers": [
  "Gavin Wood",
  "Christian Reitwiessner",
  "Alex Beregszaszi"
 ],
 "summary": "Statically typed, curly-brace, contract-oriented language for the Ethereum Virtual Machine with multiple inheritance (C3 linearization), modifiers, events, custom errors, explicit data locations (storage/memory/calldata) and an ABI for external calls.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".sol"
 ],
 "homepage": "https://soliditylang.org/",
 "influenced_by": [
  "cpp",
  "javascript",
  "python"
 ],
 "related": [
  {
   "id": "yul",
   "relation": "compiles-to"
  },
  {
   "id": "vyper",
   "relation": "family"
  },
  {
   "id": "fe-lang",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "No external standard: the official Solidity documentation (docs.soliditylang.org) including the ANTLR grammar, ABI specification and storage-layout chapters is the language reference; the EVM itself is defined by the Ethereum Yellow Paper and EIPs. No official formal semantics; several academic ones (K, Isabelle) exist.",
  "0": "solc (C++) in ethereum/solidity (now hosted under argotorg) is the reference compiler with a legacy codegen and a Yul-IR (via-IR) pipeline; Solang is an independent LLVM-based compiler."
 },
