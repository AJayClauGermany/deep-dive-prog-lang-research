{
 "id": "shacl",
 "name": "SHACL (Shapes Constraint Language)",
 "aliases": [
  "SHACL",
  "SHACL Core",
  "SHACL-SPARQL"
 ],
 "categories": [
  "schema-idl"
 ],
 "paradigms": [
  "declarative",
  "constraint-based"
 ],
 "typing": [
  "closed-world validation over RDF graphs"
 ],
 "first_appeared": 2017,
 "designers": [
  "Holger Knublauch",
  "Dimitris Kontokostas",
  "W3C RDF Data Shapes Working Group"
 ],
 "summary": "W3C language for validating RDF graphs against shapes: node and property shapes select focus nodes via targets and SHACL property paths and apply constraint components (cardinality, datatype, class, value range, string, logical and/or/not/xone, shape-based, closed) or SPARQL-based constraints, producing an RDF validation report.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C SHACL Recommendation (2017)",
  "W3C SHACL 1.2 Core (Working Draft)"
 ],
 "file_extensions": [
  ".ttl",
  ".shacl"
 ],
 "homepage": "https://www.w3.org/TR/shacl/",
 "influenced_by": [
  "rdf",
  "sparql"
 ],
 "related": [
  {
   "id": "shex",
   "relation": "family"
  },
  {
   "id": "rdf",
   "relation": "family"
  },
  {
   "id": "sparql",
   "relation": "embeds"
  }
 ],
 "level_notes": {
  "1": "SHACL 2017 is a W3C Recommendation; SHACL Advanced Features is a Working Group Note; SHACL 1.2 (Core, SPARQL extensions, rules, compact syntax) is being developed by the Data Shapes WG.",
  "0": "The W3C data-shapes test suite; TopBraid SHACL (Java, by the spec editor) is the de-facto reference, with pySHACL, Apache Jena SHACL and rdf-validate-shacl as independent implementations."
 },
