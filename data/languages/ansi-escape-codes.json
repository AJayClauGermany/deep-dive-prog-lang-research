  "international-standard",
  "vendor-specification"
 ],
 "homepage": "https://ecma-international.org/publications-and-standards/standards/ecma-48/",
 "level_notes": {
  "1": "ECMA-48 (5th ed., 1991) is free from Ecma; xterm's ctlseqs (Thomas Dickey) is the de facto reference for what modern emulators implement.",
  "0": "Paul Williams' DEC-compatible parser state machine (vt100.net) is the basis of most emulator parsers (vte, vtparse, xterm.js)."
 },
