  "level_notes": {
    "1": "Guile implements the Scheme reports (see scheme.json) plus extensions documented in the GNU Guile Reference Manual. www.gnu.org drops connections from the research sandbox, so manual node links report error; node names are the long-standing ones.",
    "2": "Tutorial-style material is the Scheme literature (see scheme.json); the manual's own tutorial nodes are on gnu.org.",
    "0": "Source links use the Codeberg repository (official mirror of savannah guile.git)."
  },
