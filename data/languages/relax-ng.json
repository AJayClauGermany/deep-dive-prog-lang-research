 "summary": "Schema language for XML based on regular tree grammars, unifying James Clark's TREX and Murata Makoto's RELAX; patterns (element, attribute, group, interleave, choice, data, list) are combined freely and validated with Brzozowski-style derivatives. Has an XML syntax and a compact non-XML syntax.",
 "status": "maintained",
 "defined_by": [
  "consortium-standard",
  "international-standard"
 ],
 "standards": [
  "OASIS RELAX NG Specification (2001)",
  "OASIS RELAX NG Compact Syntax (2002)",
  "ISO/IEC 19757-2:2008 (DSDL Part 2)"
 ],
 "file_extensions": [
  ".rng",
  ".rnc"
 ],
 "homepage": "https://relaxng.org/",
 "influenced_by": [
  "dtd",
  "xml-schema"
 ],
