  }
 ],
 "level_notes": {
  "1": "OASIS Committee Specifications (XML syntax 2001, compact syntax 2002) were adopted as ISO/IEC 19757-2, which is freely downloadable from ISO's Publicly Available Standards page (zip).",
  "0": "Jing (Java, James Clark) is the reference validator and Trang converts between RNG, RNC, DTD and XSD; libxml2 includes an independent C validator."
 },
