 "first_appeared": 1991,
 "designers": [
  "Jeffrey H. Kingston"
 ],
 "summary": "Document formatting language by Jeffrey Kingston: a small lazy functional language of \"objects\" and user-defined symbols with parameters, galleys and cross references, from which all document features (sections, tables, equations, diagrams, bibliographies) are built as libraries; Lout emits PostScript or PDF directly.",
 "status": "maintained",
