  "Sharon Shoham"
 ],
 "summary": "A language and tool for specifying, implementing and verifying distributed protocols: imperative actions over first-order relational state, restricted to decidable logic fragments (EPR) so that inductive invariants can be checked automatically with Z3; it also supports compositional assume-guarantee reasoning, specification-based testing and extraction to C++.",
 "status": "maintained",
 "defined_by": [
  "reference-implementation",
  "academic-paper"
 ],
