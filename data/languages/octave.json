 "influenced_by": [
  "matlab"
 ],
 "related": [
  {
   "id": "matlab",
   "relation": "variant-of"
  }
 ],
 "level_notes": {
  "1": "No standard; the GNU Octave manual plus MATLAB compatibility define the language.",
  "0": "GitHub mirror of the canonical Mercurial repository; links use the 'stable' branch."
 },
