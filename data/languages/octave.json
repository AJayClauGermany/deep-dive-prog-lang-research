  "object-oriented"
 ],
 "typing": [
  "dynamic"
 ],
 "first_appeared": 1988,
 "designers": [
  "John W. Eaton"
 ],
 "summary": "Free high-level numerical language and interpreter, designed to be largely source-compatible with MATLAB while adding extensions such as do-until, unwind_protect, ++ and C-style operators.",
 "status": "active",
 "defined_by": [
  "reference-implementation"
 ],
 "file_extensions": [
  ".m"
 ],
