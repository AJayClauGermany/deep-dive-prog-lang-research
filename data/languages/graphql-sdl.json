{
 "id": "graphql-sdl",
 "name": "GraphQL Schema Definition Language (SDL)",
 "aliases": [
  "GraphQL SDL",
  "GraphQL IDL",
  "GraphQL type system definition language"
 ],
 "categories": [
  "schema-idl"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "static",
  "nominal",
  "non-null by annotation",
  "interfaces and unions"
 ],
 "first_appeared": 2018,
 "designers": [
  "Lee Byron",
  "GraphQL Working Group"
 ],
 "summary": "The type-system definition part of the GraphQL language: schema, scalar, object, interface, union, enum and input-object type definitions with fields, arguments, directives, descriptions and type extensions, used to declare the schema a GraphQL service exposes. Standardised in the June 2018 GraphQL specification.",
 "status": "active",
 "defined_by": [
  "community-specification"
 ],
 "standards": [
  "GraphQL Specification, September 2025 Edition",
  "GraphQL Specification, October 2021 Edition",
  "GraphQL Specification, June 2018 Edition"
 ],
 "file_extensions": [
  ".graphql",
  ".graphqls",
  ".gql"
 ],
 "homepage": "https://graphql.org/learn/schema/",
 "influenced_by": [
  "graphql"
 ],
 "related": [
  {
   "id": "graphql",
   "relation": "subset-of"
  }
 ],
 "level_notes": {
  "1": "Defined by section 3 (Type System) and the Appendix grammar of the GraphQL Specification maintained by the GraphQL Foundation's working group; changes go through an RFC process (graphql-spec repository, rfcs/ directory).",
  "0": "graphql-js is the reference implementation: buildASTSchema/extendSchema turn SDL into schemas and findBreakingChanges implements schema-evolution checks."
 },
