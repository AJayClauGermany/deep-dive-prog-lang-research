{
 "id": "raml",
 "name": "RAML (RESTful API Modeling Language)",
 "aliases": [
  "RAML 1.0",
  "RAML 0.8"
 ],
 "categories": [
  "schema-idl",
  "domain-specific"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "nominal and structural",
  "multiple inheritance",
  "union types"
 ],
 "first_appeared": 2013,
 "designers": [
  "Uri Sarid",
  "MuleSoft",
  "RAML Workgroup"
 ],
 "summary": "YAML-based language for modelling RESTful HTTP APIs, with its own type system (built-in and user-defined types, facets, type expressions, unions, multiple inheritance), reusable resource types and traits, annotations, libraries and overlays/extensions.",
 "status": "maintained",
 "defined_by": [
  "community-specification"
 ],
 "standards": [
  "RAML 1.0 (2016)",
  "RAML 0.8 (2014)"
 ],
 "file_extensions": [
  ".raml"
 ],
 "homepage": "https://raml.org/",
 "influenced_by": [
  "yaml",
  "json-schema"
 ],
 "related": [
  {
   "id": "openapi",
   "relation": "family"
  },
  {
   "id": "yaml",
   "relation": "subset-of"
  }
 ],
 "level_notes": {
  "1": "The RAML Workgroup's Markdown specification in raml-org/raml-spec (no formal standards body). Development has largely stopped since MuleSoft adopted OpenAPI alongside RAML.",
  "0": "raml-js-parser-2 was the reference parser for RAML 1.0; MuleSoft's AMF (API Modeling Framework) parses RAML, OAS and AsyncAPI into a common model."
 },
