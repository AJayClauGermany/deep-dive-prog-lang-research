{
 "id": "asyncapi",
 "name": "AsyncAPI",
 "aliases": [
  "AsyncAPI Specification"
 ],
 "categories": [
  "schema-idl",
  "domain-specific"
 ],
 "paradigms": [
  "declarative",
  "event-driven"
 ],
 "typing": [
  "structural",
  "json-schema-based (multi-format schemas: Avro, RAML, Protobuf)"
 ],
 "first_appeared": 2017,
 "designers": [
  "Fran Méndez",
  "Lukasz Gornicki",
  "AsyncAPI Initiative"
 ],
 "summary": "JSON/YAML interface description language for message-driven and event-driven APIs (Kafka, AMQP, MQTT, WebSocket, ...): an AsyncAPI document declares servers, channels, operations (send/receive), messages and their payload schemas, with protocol-specific bindings. Started as an adaptation of OpenAPI.",
 "status": "active",
 "defined_by": [
  "community-specification"
 ],
 "standards": [
  "AsyncAPI 3.0.0 (2023)",
  "AsyncAPI 2.6.0"
 ],
 "file_extensions": [
  ".yaml",
  ".yml",
  ".json"
 ],
 "homepage": "https://www.asyncapi.com/",
 "influenced_by": [
  "openapi",
  "json-schema"
 ],
 "related": [
  {
   "id": "openapi",
   "relation": "family"
  },
  {
   "id": "json-schema",
   "relation": "embeds"
  }
 ],
 "level_notes": {
  "1": "Specified by the AsyncAPI Initiative (Linux Foundation project); the Markdown source in asyncapi/spec is rendered at asyncapi.com/docs/reference/specification. Protocol bindings are separate specifications in asyncapi/bindings.",
  "0": "asyncapi/spec-json-schemas holds the JSON Schemas that validate AsyncAPI documents; parser-js is the official parser, used by the CLI and the template-based code generator.",
  "3": "No Wikipedia or PLDB entry exists; the official tools catalog is the main tertiary listing."
 },
