{
  "id": "clu",
  "name": "CLU",
  "categories": [
    "general-purpose",
    "object-oriented",
    "historical"
  ],
  "paradigms": [
    "imperative",
    "abstract-data-types",
    "modular"
  ],
  "typing": [
    "static",
    "strong"
  ],
  "first_appeared": 1975,
  "designers": [
    "Barbara Liskov",
    "MIT students"
  ],
  "summary": "MIT language built around clusters (abstract data types), parameterized modules with where-clauses, iterators (yield) and termination-model exceptions; a major influence on Ada, C++ templates, Python and Java.",
  "defined_by": [
    "academic-paper",
    "reference-implementation"
  ],
  "file_extensions": [
    ".clu",
    ".spc",
    ".equ"
  ],
  "influenced_by": [
    "simula",
    "algol-60",
    "lisp"
  ],
  "level_notes": {
    "1": "The CLU Reference Manual (TR-225, also LNCS 114) is the definition; deep links use PDF page numbers of the scanned report (printed page + 2).",
    "0": "Portable CLU (pclu, CLU compiled to C) survives and builds; the 1978 PDP-10 ITS system also survives in archival form."
  },
