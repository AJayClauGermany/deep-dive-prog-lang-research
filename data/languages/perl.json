 "first_appeared": 1987,
 "designers": [
  "Larry Wall"
 ],
 "summary": "Dynamically typed scripting language created by Larry Wall for text processing and system administration, notable for sigils, context-sensitive evaluation (scalar vs list), built-in regular expressions, reference-counted memory and a package/bless-based object model; perl5 is both the reference implementation and the de facto definition.",
 "status": "active",
 "defined_by": [
  "reference-implementation"
 ],
 "file_extensions": [
  ".pl",
  ".pm",
  ".t",
  ".pod",
  ".xs"
 ],
 "homepage": "https://www.perl.org/",
 "influenced_by": [
  "c",
  "awk",
  "sed",
  "posix-sh",
  "lisp",
  "basic"
 ],
 "related": [
