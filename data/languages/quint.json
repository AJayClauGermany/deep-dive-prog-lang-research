 ],
 "first_appeared": 2022,
 "designers": [
  "Igor Konnov",
  "Gabriela Moreira",
  "Shon Feder",
  "Informal Systems"
 ],
 "summary": "A modern specification language based on the Temporal Logic of Actions (TLA) with a programmer-friendly syntax, a static type and effect system (modes for pure, action and temporal definitions), a REPL and random simulator, and model checking through Apalache/TLC; specifications translate to TLA+.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "community-specification"
 ],
 "file_extensions": [
  ".qnt"
 ],
 "homepage": "https://quint.sh/",
 "influenced_by": [
  "tla-plus",
  "typescript",
  "scala"
 ],
 "related": [
  {
   "id": "tla-plus",
   "relation": "variant-of"
  },
  {
   "id": "tla-plus",
   "relation": "compiles-to"
  }
 ],
 "level_notes": {
  "1": "No standard: the Quint language manual (quint-lang.org/docs/lang), the builtin operator reference and the project's ADRs/RFCs define the language; the ANTLR grammar in the repository is the precise syntax.",
  "3": "No Wikipedia article yet; PLDB lists it.",
  "0": "informalsystems/quint (TypeScript) contains parser, type/effect checker, simulator and REPL; model checking delegates to Apalache (Scala)."
 },
