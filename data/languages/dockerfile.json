 "first_appeared": 2013,
 "designers": [
  "Solomon Hykes",
  "Docker, Inc."
 ],
 "summary": "Instruction-per-line language for describing container image builds (FROM, RUN, COPY, ENV, ARG, CMD ...), interpreted by Docker/BuildKit and compatible builders such as Buildah/Podman; RUN bodies are shell commands, and the frontend supports parser directives, variable substitution, heredocs and multi-stage builds.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  "Dockerfile",
  "Containerfile",
  ".dockerfile"
 ],
 "homepage": "https://docs.docker.com/reference/dockerfile/",
