   "relation": "embeds"
  },
  {
   "id": "make",
   "relation": "family"
  }
 ],
 "level_notes": {
  "0": "BuildKit's Dockerfile frontend (moby/buildkit frontend/dockerfile) is the reference implementation; Buildah implements the same language for Containerfiles.",
  "1": "The Dockerfile reference on docs.docker.com is the definition; no independent standard (the OCI image spec covers the output, not the language).",
  "2": "Docker's build guides and best-practice pages.",
  "3": "Wikipedia, PLDB."
 },
