{
  "id": "mustache",
  "name": "Mustache",
  "aliases": [
    "{{mustache}}"
  ],
  "categories": [
    "template"
  ],
  "paradigms": [
    "declarative",
    "logic-less"
  ],
  "typing": [
    "untyped"
  ],
  "first_appeared": 2009,
  "designers": [
    "Chris Wanstrath"
  ],
  "summary": "Logic-less template language using {{tags}} for interpolation, sections (iteration/conditionals over data), partials and optional lambdas and inheritance; implemented in dozens of host languages against a shared YAML conformance spec.",
  "status": "active",
  "defined_by": [
    "community-specification"
  ],
  "file_extensions": [
    ".mustache"
  ],
  "homepage": "https://mustache.github.io/",
  "influenced_by": [
    "ctemplate"
  ],
  "related": [
    {
      "id": "handlebars",
      "relation": "family"
    }
  ],
  "level_notes": {
    "1": "The mustache(5) manual is the human-readable definition; the mustache/spec YAML files (v1.4) are the normative, test-based specification, with ~lambdas, ~inheritance and ~dynamic-names as optional modules.",
    "0": "No single canonical implementation; the original Ruby gem and mustache.js are the historical references. Many implementations exist (see mustache.github.io)."
  },
