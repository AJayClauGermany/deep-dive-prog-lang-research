 ],
 "first_appeared": 2003,
 "designers": [
  "Carsten Dominik",
  "Bastien Guerry",
  "Ihor Radchenko (maintainer)"
 ],
 "summary": "The outline-based plain-text markup of the Emacs Org mode: headings, drawers and properties, plain lists, tables with a spreadsheet formula language, links, macros, timestamps and executable source blocks (Babel) for literate programming; exported to HTML, LaTeX, ODT and more.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "community-specification"
 ],
