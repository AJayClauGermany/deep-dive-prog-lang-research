{
 "id": "vcard-icalendar",
 "name": "iCalendar / vCard",
 "aliases": [
  "iCal",
  "ICS",
  "VCF",
  "RFC 5545",
  "RFC 6350"
 ],
 "categories": [
  "data-serialization",
  "protocol"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "typed values"
 ],
 "first_appeared": 1995,
 "designers": [
  "Versit Consortium",
  "IETF calsify / vcarddav working groups"
 ],
 "summary": "Line-oriented text formats for calendar data (iCalendar, RFC 5545) and contact data (vCard, RFC 6350): nested BEGIN/END components containing NAME;PARAM=value:VALUE content lines with folding, backslash escaping and typed values (DATE-TIME, RECUR rules, URIs). Shared descendants of the Versit vCalendar/vCard formats, with JSON (jCal/jCard) and XML (xCal/xCard) mappings.",
 "status": "active",
 "defined_by": [
  "international-standard"
 ],
 "file_extensions": [
  ".ics",
  ".ifb",
  ".vcf",
  ".vcard"
 ],
 "homepage": "https://icalendar.org/",
 "level_notes": {
  "1": "IETF RFCs: 5545 (iCalendar core), 5546 (iTIP), 7986 (new properties), 6350 (vCard 4.0), 2426 (vCard 3.0), plus JSON/XML mappings 7265/7095/6321/6351."
 },
