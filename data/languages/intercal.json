 "summary": "Compiler Language With No Pronounceable Acronym, created by Don Woods and James Lyon in 1972 as a parody of contemporary languages; revived as C-INTERCAL by Eric Raymond (1990) with COME FROM, threading and backtracking extensions.",
 "status": "esoteric",
 "defined_by": [
  "informal",
  "reference-implementation"
 ],
 "file_extensions": [
  ".i",
  ".3i"
 ],
 "homepage": "http://www.catb.org/~esr/intercal/",
 "level_notes": {
  "1": "The 1973 INTERCAL Reference Manual (Woods & Lyon) is reproduced and extended in the C-INTERCAL Revamped Manual, whose section anchors are linked here.",
  "0": "C-INTERCAL (esr/intercal on GitLab) is the de facto reference; CLC-INTERCAL (Claudio Calvelli) is the other major implementation.",
  "2": "Secondary literature is thin; the manual's tutorial-like chapters double as the guide."
 },
