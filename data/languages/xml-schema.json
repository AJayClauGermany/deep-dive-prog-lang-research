  "nominal"
 ],
 "first_appeared": 2001,
 "designers": [
  "W3C XML Schema Working Group"
 ],
 "summary": "W3C language for describing the structure and datatypes of XML documents: element/attribute declarations, complex types with derivation by extension/restriction, a library of built-in datatypes with facets, identity constraints, and (in 1.1) assertions and conditional type assignment.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C XSD 1.0 (2001, 2nd ed. 2004)",
  "W3C XSD 1.1 (2012)"
 ],
 "file_extensions": [
  ".xsd"
 ],
 "homepage": "https://www.w3.org/XML/Schema",
 "influenced_by": [
  "xml",
  "sgml"
 ],
 "related": [
  {
   "id": "relax-ng",
   "relation": "family"
  },
  {
   "id": "schematron",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "Normative: XSD 1.1 Parts 1 and 2 (2012); XSD 1.0 2nd edition still widely implemented. The Primer (Part 0) is non-normative and listed at level 2.",
  "0": "Validators (Xerces-J supports 1.1; libxml2 only 1.0) and the W3C test suite; none is normative."
 },
