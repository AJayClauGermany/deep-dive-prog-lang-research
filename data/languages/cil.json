 ],
 "level_notes": {
  "1": "ECMA-335 (free PDF from Ecma; identical ISO/IEC 23271 is paywalled) defines CIL in Partition III and metadata/ILAsm syntax in Partition II; the standard has not been revised since 2012 and the dotnet/runtime 'augments' document records later changes.",
  "0": "CoreCLR and Mono (both in dotnet/runtime) are the main implementations."
 },
