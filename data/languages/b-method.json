 "designers": [
  "Jean-Raymond Abrial"
 ],
 "summary": "Abrial's B-Method specifies software as abstract machines over set theory and first-order logic, refined step by step (generalised substitutions) down to the implementable B0 subset with proof obligations discharged at each step; Event-B is its successor for system-level modelling with guarded events, supported by the Rodin platform.",
 "status": "active",
 "defined_by": [
  "academic-paper",
  "vendor-specification"
 ],
 "file_extensions": [
  ".mch",
  ".ref",
  ".imp",
  ".bum",
  ".buc"
 ],
 "homepage": "https://www.atelierb.eu/en/",
