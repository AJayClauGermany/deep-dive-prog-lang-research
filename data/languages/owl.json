{
 "id": "owl",
 "name": "OWL 2 Web Ontology Language",
 "aliases": [
  "OWL",
  "OWL 2",
  "OWL DL",
  "OWL 2 EL/QL/RL"
 ],
 "categories": [
  "schema-idl",
  "logic"
 ],
 "paradigms": [
  "declarative",
  "logic-based (description logic)"
 ],
 "typing": [
  "open-world",
  "description-logic classes"
 ],
 "first_appeared": 2004,
 "designers": [
  "Ian Horrocks",
  "Peter F. Patel-Schneider",
  "Boris Motik",
  "Bijan Parsia",
  "Frank van Harmelen",
  "W3C OWL Working Group"
 ],
 "summary": "W3C ontology language for the Semantic Web based on the description logic SROIQ(D): classes, object/data properties, individuals, class expressions (intersection, union, complement, existential/universal/cardinality restrictions) and axioms with a direct (model-theoretic) and an RDF-based semantics, several syntaxes (RDF, Functional, Manchester, OWL/XML) and tractable profiles EL, QL and RL.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C OWL 2 (Second Edition, 2012)",
  "W3C OWL Web Ontology Language (2004)"
 ],
 "file_extensions": [
  ".owl",
  ".ofn",
  ".omn",
  ".owx",
  ".ttl"
 ],
 "homepage": "https://www.w3.org/TR/owl2-overview/",
 "influenced_by": [
  "rdfs",
  "daml-oil",
  "description-logics"
 ],
 "related": [
  {
   "id": "rdfs",
   "relation": "superset-of"
  },
  {
   "id": "rdf",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "OWL 2 is a 13-document W3C Recommendation suite; the Structural Specification and Functional-Style Syntax defines the language, with separate Direct Semantics, RDF-Based Semantics, Mapping to RDF, Profiles and Conformance documents.",
  "0": "The OWL API (Java) is the standard parser/serializer library; reasoners include HermiT, Pellet/Openllet, ELK (OWL 2 EL) and the Python owlready2/OWL-RL packages. Official test cases are described in the Conformance document."
 },
