{
 "id": "gherkin",
 "name": "Gherkin",
 "aliases": [
  "Cucumber feature files",
  "Given-When-Then"
 ],
 "categories": [
  "specification-modeling",
  "domain-specific"
 ],
 "paradigms": [
  "declarative",
  "behaviour-driven-development"
 ],
 "typing": [
  "untyped"
 ],
 "first_appeared": 2008,
 "designers": [
  "Aslak Hellesøy",
  "Cucumber project"
 ],
 "summary": "The line-oriented, natural-language-like specification language of behaviour-driven development used by Cucumber, SpecFlow/Reqnroll, Behave and others: Feature, Rule, Scenario/Example, Scenario Outline and Background blocks containing Given/When/Then steps, with doc strings, data tables, tags and keyword translations for over 70 spoken languages.",
 "status": "active",
 "defined_by": [
  "community-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".feature"
 ],
 "homepage": "https://cucumber.io/docs/gherkin/",
 "level_notes": {
  "1": "No formal standard: the Cucumber Gherkin Reference is the de facto specification, and the Berp grammar (gherkin.berp) in cucumber/gherkin is the precise syntax shared by all official parsers.",
  "0": "cucumber/gherkin generates parsers in a dozen languages (Java, JavaScript, Go, Python, Ruby, C#, ...) from one grammar; the shared testdata directory acts as a conformance suite."
 },
