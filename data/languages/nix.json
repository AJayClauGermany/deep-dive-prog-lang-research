 "summary": "Pure, lazy, dynamically typed functional language used to describe packages and system configurations for the Nix package manager, NixOS and nixpkgs; values are attribute sets, lists, strings with context, paths and functions, and derivations describe build actions.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "academic-paper"
 ],
 "file_extensions": [
  ".nix"
 ],
 "homepage": "https://nixos.org/",
 "level_notes": {
  "1": "No formal specification; the Nix Reference Manual's language chapter is the reference. Dolstra's PhD thesis gives a formal semantics of the original language.",
  "0": "NixOS/nix (C++; lexer.l, parser.y, eval.cc) is the reference evaluator; Lix and Tvix are alternative implementations."
 },
