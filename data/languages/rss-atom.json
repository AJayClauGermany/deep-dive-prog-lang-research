  "IETF AtomPub WG (Mark Nottingham, Robert Sayre)"
 ],
 "summary": "XML web-feed formats: RSS (0.9x/2.0 lineage from Netscape and UserLand, and the RDF-based RSS 1.0) and its IETF-standardised successor Atom (RFC 4287), which describe a channel/feed of dated items/entries with links, authors, categories and typed text or HTML content.",
 "status": "maintained",
 "defined_by": [
  "community-specification",
  "international-standard"
 ],
 "standards": [
  "RSS 2.0.11 (RSS Advisory Board)",
  "RSS 1.0 (RDF Site Summary, 2000)",
  "RFC 4287 (Atom Syndication Format, 2005)",
  "RFC 5023 (Atom Publishing Protocol)"
 ],
 "file_extensions": [
  ".rss",
  ".atom",
  ".xml"
 ],
 "homepage": "https://www.rssboard.org/",
 "influenced_by": [
  "xml",
  "rdf"
 ],
 "related": [
  {
   "id": "xml",
   "relation": "dialect-of"
  }
 ],
 "level_notes": {
  "1": "RSS 2.0 is maintained by the RSS Advisory Board (an informal spec frozen by Harvard/Winer in 2003); Atom is IETF Proposed Standard RFC 4287 with a normative RELAX NG schema in Appendix B.",
  "0": "No reference implementation; Universal Feed Parser (Python), gofeed (Go) and the W3C Feed Validation Service are the de-facto conformance tools."
 },
