 "summary": "Pattern language for matching elements in a document tree, defined by the W3C CSS Working Group and used by CSS rules, the DOM querySelector API and many scraping/testing tools: type, class, id and attribute selectors, pseudo-classes, combinators and (Level 4) logical and relational selectors such as :is(), :not() and :has().",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C Selectors Level 3 (Recommendation)",
  "W3C Selectors Level 4 (Working Draft)"
 ],
 "homepage": "https://drafts.csswg.org/selectors-4/",
 "related": [
  {
   "id": "css",
   "relation": "subset-of"
  }
 ],
 "level_notes": {
  "1": "Selectors Level 3 is a W3C Recommendation; Level 4 is a Working Draft (deep links point at the CSSWG editor's draft). www.w3.org returns a Cloudflare 403 to the link checker; those links were verified with plain curl.",
  "0": "Implemented in every browser engine (Servo/Stylo's selectors crate, WebKit SelectorChecker and its selector JIT) and in standalone libraries (css-what/css-select, soupsieve, nwsapi)."
 },
