   "relation": "family"
  },
  {
   "id": "cbor",
   "relation": "family"
  },
  {
   "id": "messagepack",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "The ubjson.org pages (Draft 12) are the only specification; the NeuroJSON BJData spec is a compatible successor that adds packed N-D arrays.",
  "0": "No reference implementation; py-ubjson and nlohmann/json's binary_reader are well-maintained implementations.",
  "2": "Little secondary literature beyond library documentation."
 },
