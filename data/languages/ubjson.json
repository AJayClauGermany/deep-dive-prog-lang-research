{
 "id": "ubjson",
 "name": "UBJSON",
 "aliases": [
  "Universal Binary JSON"
 ],
 "categories": [
  "data-serialization"
 ],
 "paradigms": [
  "declarative",
  "data"
 ],
 "typing": [
  "dynamic",
  "self-describing"
 ],
 "first_appeared": 2012,
 "designers": [
  "Riyad Kalla"
 ],
 "summary": "Binary encoding that maps 1:1 onto the JSON data model using single-byte type markers, big-endian fixed-size numbers and optional typed/counted ('optimized') containers; never progressed past Draft 12 and was extended as BJData.",
 "status": "maintained",
 "defined_by": [
  "community-specification"
 ],
 "standards": [
  "UBJSON Draft 12"
 ],
 "file_extensions": [
  ".ubj"
 ],
 "homepage": "https://ubjson.org/",
 "influenced_by": [
  "json"
 ],
