{
 "id": "firrtl",
 "name": "FIRRTL",
 "aliases": [
  "Flexible Intermediate Representation for RTL"
 ],
 "categories": [
  "hardware-description",
  "intermediate-representation"
 ],
 "paradigms": [
  "structural",
  "dataflow"
 ],
 "typing": [
  "static",
  "strong",
  "width-inferred"
 ],
 "first_appeared": 2016,
 "designers": [
  "Adam Izraelevitz",
  "Patrick Li",
  "Jonathan Bachrach",
  "UC Berkeley"
 ],
 "summary": "Intermediate representation for synchronous digital circuits produced by Chisel and other generators; a textual language of circuits, modules, typed ground/aggregate signals, last-connect semantics and conditionals that compilers (the Scala FIRRTL compiler, now CIRCT firtool) lower to Verilog.",
 "status": "active",
 "defined_by": [
  "community-specification"
 ],
 "file_extensions": [
  ".fir"
 ],
 "homepage": "https://github.com/chipsalliance/firrtl-spec",
 "influenced_by": [
  "verilog",
  "llvm-ir"
 ],
 "related": [
  {
   "id": "chisel",
   "relation": "family"
  },
  {
   "id": "verilog",
   "relation": "compiles-to"
  }
 ],
 "level_notes": {
  "1": "The FIRRTL specification (chipsalliance/firrtl-spec, versioned releases) is normative; the 2016 Berkeley tech report is the original specification.",
  "2": "Little secondary literature targets FIRRTL directly; tutorials teach it through Chisel (see chisel).",
  "0": "The original Scala compiler (chipsalliance/firrtl) is deprecated; CIRCT (llvm/circt) firtool is the current implementation."
 },
