  }
 ],
 "level_notes": {
  "1": "The Maude Manual (current release PDF, distributed as a GitHub release asset) and the book All About Maude define the language; its foundations are Meseguer's rewriting-logic papers.",
  "0": "The Maude interpreter (C++, Steven Eker, maude-lang/Maude) is the only full implementation; the parser front end is bison/flex in src/Mixfix."
 },
