 "designers": [
  "Cloudant",
  "Apache CouchDB project"
 ],
 "summary": "MongoDB-inspired declarative JSON query language of Apache CouchDB (POST /db/_find): a selector object with implicit equality and $-prefixed condition and combination operators ($and, $or, $elemMatch, $regex ...), plus fields projection, sort, limit/skip, bookmarks, and JSON/text index definitions.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "homepage": "https://docs.couchdb.org/en/stable/ddocs/mango.html",
 "influenced_by": [
  "mongodb-mql"
 ],
 "related": [
  {
   "id": "json",
   "relation": "embeds"
  }
 ],
 "level_notes": {
  "1": "Defined by the Apache CouchDB documentation (Mango selectors in ddocs/mango.html; the /db/_find, /_index and /_explain endpoints in api/database/find.html). IBM Cloudant Query and PouchDB-find implement the same syntax.",
  "0": "Originated as Cloudant's mango (Erlang) and merged into CouchDB as src/mango; PouchDB contains an independent JavaScript selector matcher.",
  "3": "No dedicated encyclopedia entry; the CouchDB Wikipedia article covers it only in passing."
 },
