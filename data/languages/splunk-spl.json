 ],
 "level_notes": {
  "0": "Proprietary; no open-source implementation. Level 0 lists the official SDK framework for writing custom search commands and the official VS Code extension.",
  "1": "The Splunk Enterprise Search Reference (help.splunk.com, version 10.6 paths) is the vendor definition; SPL2 has its own Search Reference.",
  "3": "PLDB has no entry for SPL (pldb.io/concepts/spl.html is an unrelated language)."
 },
