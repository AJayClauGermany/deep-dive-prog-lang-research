 "first_appeared": 2013,
 "designers": [
  "Kenton Varda"
 ],
 "summary": "Zero-copy serialization format and capability-based RPC system by the former Protocol Buffers v2 author: the wire format is the in-memory format (8-byte words, pointers, segments), schemas support generics, groups, unions and annotations, and RPC has promise pipelining.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".capnp"
 ],
 "homepage": "https://capnproto.org/",
 "related": [
  {
   "id": "protobuf",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "capnproto.org language and encoding pages, plus schema.capnp / rpc.capnp in the repo which are self-describing normative schemas.",
  "0": "capnproto/capnproto (C++, the capnp compiler) is the reference; Rust, Go and others are third-party.",
  "2": "Secondary literature is thin; the official site pages double as the tutorial and the design rationale (see the language page's protocol-evolution section)."
 },
