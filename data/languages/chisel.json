   "id": "firrtl",
   "relation": "compiles-to"
  }
 ],
 "level_notes": {
  "1": "No formal specification: the chisel-lang.org documentation and the Scala API are the reference; the DAC 2012 paper defines the original design.",
  "0": "chipsalliance/chisel is the definition in practice; elaborated designs are emitted as FIRRTL and compiled by CIRCT firtool."
 },
