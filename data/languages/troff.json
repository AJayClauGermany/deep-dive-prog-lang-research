  {
   "id": "mdoc",
   "relation": "host-of"
  },
  {
   "id": "tex",
   "relation": "family"
  }
 ],
 "level_notes": {
  "0": "Historic AT&T troff (DWB), its Heirloom descendant, neatroff and GNU groff (canonical repo on git.savannah.gnu.org, not linked) implement the language.",
  "1": "CSTR 54 (Ossanna/Kernighan) is the classic definition; groff(7) and the groff Texinfo manual document GNU troff. gnu.org returns 403 to the link checker."
 },
