 "first_appeared": 1973,
 "designers": [
  "Joseph F. Ossanna",
  "Brian W. Kernighan",
  "James Clark (groff)"
 ],
 "summary": "The Unix typesetting language: text interleaved with dot-requests (.sp, .ft, .de) and backslash escapes, with number registers, strings, macros, diversions, traps and conditionals; nroff targets terminals, troff typesetters. GNU groff is the main living implementation; macro packages (man, mdoc, ms, me, mm) and preprocessors (tbl, eqn, pic) build on it.",
 "status": "maintained",
 "defined_by": [
  "reference-implementation",
  "informal"
 ],
 "file_extensions": [
  ".roff",
  ".tr",
  ".ms",
  ".me",
  ".mm",
  ".1"
 ],
 "homepage": "https://www.gnu.org/software/groff/",
