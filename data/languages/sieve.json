 "summary": "IETF standard language for server-side email filtering: a deliberately non-Turing-complete script of tests (header, address, size...) and actions (keep, fileinto, redirect, discard) with if/elsif/else, extended through 'require'd extensions defined in further RFCs.",
 "status": "active",
 "defined_by": [
  "international-standard"
 ],
 "standards": [
  "RFC 5228 (2008)",
  "RFC 3028 (2001, obsoleted)"
 ],
