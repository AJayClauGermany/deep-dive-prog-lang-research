  ".sieve",
  ".siv"
 ],
 "homepage": "http://sieve.info/",
 "level_notes": {
  "0": "Dovecot Pigeonhole and Cyrus IMAP sieve are the major implementations.",
  "1": "RFC 5228 plus extension RFCs (variables, vacation, relational, imap4flags, body ...) and ManageSieve.",
  "2": "Little secondary literature beyond implementation docs.",
  "3": "Wikipedia."
 },
