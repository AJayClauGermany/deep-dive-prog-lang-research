{
 "id": "webassembly",
 "name": "WebAssembly",
 "aliases": ["Wasm", "WAT (WebAssembly text format)"],
 "categories": ["bytecode", "intermediate-representation", "assembly", "abstract-machine"],
 "paradigms": ["imperative", "stack-based", "structured"],
 "typing": ["static", "strong", "nominal-and-structural", "validated"],
 "first_appeared": 2017,
 "designers": ["Andreas Rossberg", "Ben L. Titzer", "Andreas Haas", "Derek L. Schuff", "Dan Gohman", "Luke Wagner", "Alon Zakai", "JF Bastien", "Michael Holman"],
 "summary": "Portable, sandboxed stack-machine instruction format with structured control flow, a formally specified type system and semantics, a compact binary encoding and an S-expression text format (WAT); standardised by the W3C WebAssembly Working Group as a compilation target for the web and beyond.",
 "status": "active",
 "defined_by": ["consortium-standard", "community-specification"],
 "standards": ["W3C WebAssembly Core Specification 1.0 (2019)", "W3C WebAssembly Core Specification 2.0", "WebAssembly 3.0 (2025)"],
 "file_extensions": [".wasm", ".wat", ".wast"],
 "homepage": "https://webassembly.org/",
 "influenced_by": ["javascript", "llvm-ir", "jvm-bytecode"],
 "related": [{"id": "javascript", "relation": "host-of"}, {"id": "llvm-ir", "relation": "family"}, {"id": "assemblyscript", "relation": "compiles-to"}, {"id": "jvm-bytecode", "relation": "family"}],
 "level_notes": {"0": "The OCaml reference interpreter in WebAssembly/spec (interpreter/) accompanies the spec and runs the official .wast conformance suite in test/core; SpecTec (spectec/) now generates the spec's formal rules. Independent implementations: wabt (C++ tools and interpreter), Binaryen (optimizer IR), wasmtime/Cranelift and wasm-tools (Rust), WAMR and wasm3 (interpreters), V8 Liftoff/TurboFan, SpiderMonkey, JavaScriptCore.", "1": "Normative: the W3C Core Specification (living draft at webassembly.github.io/spec, versions 1.0/2.0 as W3C Recommendations, 3.0 released 2025), plus the JS API and Web API specs. Features enter through the phased proposals process; proposal overview documents are linked here. The core spec contains a full formal semantics and soundness theorem; mechanised versions exist (WasmCert-Isabelle, WasmCert-Coq).", "2": "MDN's WebAssembly guides and instruction reference, the PLDI 2017 design paper by the designers (listed as level 1 original-paper), performance studies and blog posts on engine internals.", "3": "Wikipedia, PLDB and awesome-wasm."},
