{
 "id": "json-ld",
 "name": "JSON-LD",
 "aliases": [
  "JSON for Linking Data",
  "JSON-LD 1.1"
 ],
 "categories": [
  "data-serialization",
  "schema-idl"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "rdf-based",
  "type coercion via @context"
 ],
 "first_appeared": 2010,
 "designers": [
  "Manu Sporny",
  "Gregg Kellogg",
  "Markus Lanthaler",
  "Dave Longley",
  "Niklas Lindström"
 ],
 "summary": "JSON-based serialization of RDF/Linked Data: an @context maps JSON keys to IRIs and declares type coercion, containers (lists, sets, language/index/id/type maps) and scoping, so ordinary JSON documents can be expanded, compacted, flattened and framed by standard algorithms and converted to/from RDF datasets.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C JSON-LD 1.1 (2020)",
  "W3C JSON-LD 1.1 Processing Algorithms and API",
  "W3C JSON-LD 1.1 Framing",
  "W3C JSON-LD 1.0 (2014)"
 ],
 "file_extensions": [
  ".jsonld"
 ],
 "homepage": "https://json-ld.org/",
 "influenced_by": [
  "json",
  "rdf",
  "turtle"
 ],
 "related": [
  {
   "id": "rdf",
   "relation": "family"
  },
  {
   "id": "json",
   "relation": "superset-of"
  }
 ],
 "level_notes": {
  "1": "Three W3C Recommendations (syntax, processing algorithms/API, framing). The API document defines expansion/compaction/flattening/RDF conversion as step-by-step algorithms.",
  "0": "The json-ld-api repository holds the official test manifests; jsonld.js (JavaScript) and pyld (Python) by Digital Bazaar are the most complete implementations."
 },
