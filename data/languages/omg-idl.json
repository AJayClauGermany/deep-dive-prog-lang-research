{
 "id": "omg-idl",
 "name": "OMG IDL (CORBA / DDS Interface Definition Language)",
 "aliases": [
  "OMG IDL",
  "CORBA IDL",
  "IDL4",
  "ISO/IEC 14750"
 ],
 "categories": [
  "schema-idl"
 ],
 "paradigms": [
  "declarative",
  "object-oriented"
 ],
 "typing": [
  "static",
  "nominal"
 ],
 "first_appeared": 1991,
 "designers": [
  "Object Management Group"
 ],
 "summary": "C++-like, language-neutral interface definition language from the Object Management Group: modules, interfaces with operations and attributes, exceptions, structs, unions, enums, sequences and typedefs, mapped to many programming languages. Originally part of CORBA, IDL 4.x is a standalone, building-block-structured spec also used by DDS (with XTypes annotations).",
 "status": "maintained",
 "defined_by": [
  "consortium-standard",
  "international-standard"
 ],
 "standards": [
  "OMG IDL 4.2 (2018)",
  "OMG IDL 3.5",
  "ISO/IEC 14750:1999",
  "ISO/IEC 19516 (IDL 4.2)"
 ],
 "file_extensions": [
  ".idl"
 ],
 "homepage": "https://www.omg.org/spec/IDL/",
 "influenced_by": [
  "c++",
  "dce-idl"
 ],
 "related": [
  {
   "id": "webidl",
   "relation": "family"
  },
  {
   "id": "midl",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "OMG specifications are freely downloadable as PDF (no section anchors). IDL 4.x splits the language into 'building blocks' (core data types, interfaces, value types, CORBA-specific, components, annotations...). Language mappings (IDL4-to-C++/Java) and DDS-XTypes are separate OMG specs.",
  "0": "IDL compilers ship with ORBs and DDS implementations: TAO's tao_idl (flex/bison front end), omniORB's omniidl, eProsima Fast-DDS-Gen (ANTLR grammar), OpenDDS's opendds_idl."
 },
