 ],
 "level_notes": {
  "0": "James Clark's SP (and its successor OpenSP, hosted on SourceForge which blocks automated clients) is the standard parser; real DTDs such as HTML 4.01's are listed as machine-readable grammars.",
  "1": "ISO 8879 is paywalled and no free draft exists; Goldfarb's SGML Handbook contains the annotated full text. ISO, ACM and w3.org links may show as blocked.",
  "2": "The HTML 4.01 chapter \"On SGML and HTML\" is the most accessible free tutorial."
 },
