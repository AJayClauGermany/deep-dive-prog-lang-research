 ],
 "summary": "A meta-language for defining markup languages: a document type definition (DTD) declares elements, attributes, entities and content models, and an SGML declaration fixes the concrete syntax (delimiters, tag minimisation). Descended from IBM GML; the parent of HTML (up to 4.01) and of XML, which is a simplified profile.",
 "status": "historical",
 "defined_by": [
  "international-standard"
 ],
 "standards": [
  "ISO 8879:1986",
  "ISO 8879:1986/Amd 1:1988",
  "WebSGML Adaptations (TC2, 1999)"
 ],
