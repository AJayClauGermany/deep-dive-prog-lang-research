  "Jeff Caruso",
  "Stephen Deach"
 ],
 "summary": "W3C XML vocabulary of formatting objects (fo:root, fo:page-sequence, fo:block, fo:table ...) and properties describing paginated output; typically produced from XML by an XSLT transformation and rendered to PDF by a formatter. Includes a property expression language and an area model shared in spirit with CSS.",
 "status": "maintained",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "XSL 1.0 (W3C REC 2001)",
  "XSL 1.1 (W3C REC 2006)"
 ],
 "file_extensions": [
  ".fo",
  ".xsl",
  ".fob"
 ],
