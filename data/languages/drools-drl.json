  "object-oriented"
 ],
 "typing": [
  "static",
  "dynamic"
 ],
 "first_appeared": 2001,
 "designers": [
  "Bob McWhirter",
  "Mark Proctor",
  "JBoss / Red Hat",
  "Apache KIE"
 ],
 "summary": "The rule language of the Drools business-rules engine (now Apache KIE): packages of rules with when/then sections whose conditions are patterns and constraints over Java facts (with OOPath and operators like matches, memberOf, contains), queries, type declarations, rule attributes such as salience and agenda-group, rule units, plus DSL and spreadsheet decision-table front-ends; executed by the Phreak (Rete-derived) algorithm.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "vendor-specification"
 ],
 "file_extensions": [
  ".drl",
  ".dsl",
  ".dslr"
 ],
 "homepage": "https://www.drools.org/",
 "level_notes": {
  "1": "No standard; the Drools documentation's DRL language reference is the definition, with the ANTLR grammar as precise syntax.",
  "0": "apache/incubator-kie-drools contains the parser and engine."
 },
