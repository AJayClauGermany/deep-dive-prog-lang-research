 "first_appeared": 2017,
 "designers": [
  "Gabriella Gonzalez"
 ],
 "summary": "Total, strongly typed, non-Turing-complete configuration language based on a System F-omega-like calculus with records, unions, imports by URL with semantic integrity hashes, and normalisation to JSON/YAML.",
 "status": "maintained",
 "defined_by": [
  "community-specification",
  "reference-implementation"
 ],
