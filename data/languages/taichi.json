    "shader-gpu"
  ],
  "paradigms": [
    "imperative",
    "data-parallel",
    "data-oriented",
    "differentiable"
  ],
  "typing": [
    "static (kernels)",
    "inferred",
    "annotated"
  ],
  "first_appeared": 2019,
  "designers": [
    "Yuanming Hu",
    "Tzu-Mao Li",
    "Luke Anderson",
    "Jonathan Ragan-Kelley",
    "Frédo Durand"
  ],
  "summary": "Domain-specific language embedded in Python for high-performance parallel computing: functions decorated with @ti.kernel are JIT-compiled (via LLVM, CUDA, Vulkan/SPIR-V, Metal) and their outermost loops parallelised; features spatially sparse data structures and automatic differentiation.",
  "status": "active",
  "defined_by": [
    "reference-implementation",
    "academic-paper"
  ],
  "file_extensions": [
    ".py"
  ],
  "homepage": "https://www.taichi-lang.org/",
  "influenced_by": [
    "python",
    "halide",
    "cuda"
  ],
  "related": [
    {
      "id": "python",
      "relation": "embeds"
    }
  ],
  "level_notes": {
    "1": "No separate specification; the Language Reference in the official docs plus the SIGGRAPH Asia 2019 paper define the language.",
    "0": "Single implementation (taichi-dev/taichi): Python front end transforming the Python AST into the CHI IR, C++ compiler with LLVM/SPIR-V/Metal back ends.",
    "2": "The topic pages of the official docs (kernels, fields, types, metaprogramming, compilation) are user guides, filed at level 2."
  },
