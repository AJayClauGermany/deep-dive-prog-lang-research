 ],
 "first_appeared": 1993,
 "designers": [
  "Urban Müller"
 ],
 "summary": "Urban Müller's 1993 minimalist language with eight single-character commands over a byte array and data pointer; the archetypal Turing tarpit and the most implemented esoteric language.",
 "status": "esoteric",
 "defined_by": [
  "reference-implementation",
  "informal"
 ],
 "file_extensions": [
  ".b",
  ".bf"
 ],
 "influenced_by": [
  "false"
 ],
 "homepage": "http://brainfuck.org/",
 "level_notes": {
  "1": "No formal standard; Müller's README in the brainfuck-2 archive is the original definition, with Cristofani's reference and the Epistle documenting de facto portability conventions (cell size, EOF).",
  "0": "Countless implementations; Müller's original Amiga compiler, Cristofani's C interpreters and rdebath's optimizing Tritium are linked.",
  "2": "Most worked examples are Cristofani's annotated programs on brainfuck.org (listed as by-example)."
 },
