 ],
 "level_notes": {
  "1": "ISO/IEC 24707:2007 Common Logic is freely available from ISO's publicly-available-standards list (the 2018 edition is paywalled); the original KIF 3.0 manual and dpANS at Stanford KSL are currently unreachable.",
  "0": "Few public implementations; SUMO's Sigma KEE works with SUO-KIF."
 },
