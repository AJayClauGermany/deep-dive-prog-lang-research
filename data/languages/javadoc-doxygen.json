  {
   "id": "java",
   "relation": "embeds"
  },
  {
   "id": "cpp",
   "relation": "embeds"
  },
  {
   "id": "pod",
   "relation": "family"
  },
  {
   "id": "markdown",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "Javadoc's doc-comment syntax is specified by the JDK's Documentation Comment Specification for the Standard Doclet plus JEPs (413 snippets, 467 Markdown comments); Doxygen's command set is defined only by its manual and implementation.",
  "0": "javac parses doc comments itself (DocCommentParser) into the com.sun.source.doctree API; Doxygen's comment scanner and documentation parser are flex/C++ sources."
 },
