 "first_appeared": 1995,
 "designers": [
  "Sun Microsystems (Javadoc)",
  "Dimitri van Heesch (Doxygen, 1997)"
 ],
 "summary": "Markup languages embedded in source-code comments (/** ... */, ///) that documentation generators turn into API references: Javadoc's block tags (@param, @return, @throws) and inline tags ({@link}, {@code}) with HTML or, since JDK 23, Markdown bodies; Doxygen's superset of Javadoc/Qt-style commands (\\brief, \\param, \\ref) across C, C++, Python and other languages.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".java",
  ".h",
  ".cpp",
  ".dox"
 ],
