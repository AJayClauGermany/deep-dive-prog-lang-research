{
 "id": "toml",
 "name": "TOML",
 "aliases": [
  "Tom's Obvious, Minimal Language",
  "Tom's Obvious Markup Language"
 ],
 "categories": [
  "configuration",
  "data-serialization"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "self-describing",
  "typed-scalars"
 ],
 "first_appeared": 2013,
 "designers": [
  "Tom Preston-Werner",
  "Pradyun Gedam"
 ],
 "summary": "Minimal configuration file format designed to map unambiguously to a hash table: INI-like [tables] and dotted keys, typed scalars (strings, integers, floats, booleans, first-class RFC 3339 date-times), arrays and inline tables. Used by Cargo, pyproject.toml, Hugo and many other tools.",
 "status": "active",
 "defined_by": [
  "community-specification"
 ],
 "standards": [
  "TOML v1.1.0 (2025)",
  "TOML v1.0.0 (2021)"
 ],
 "file_extensions": [
  ".toml"
 ],
 "homepage": "https://toml.io/",
 "influenced_by": [
  "ini",
  "json",
  "yaml"
 ],
 "related": [
  {
   "id": "ini",
   "relation": "family"
  },
  {
   "id": "json",
   "relation": "family"
  },
  {
   "id": "yaml",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "The versioned specification at toml.io (v1.1.0 current, v1.0.0 widely implemented) is normative, with an ABNF grammar (toml.abnf) kept in the toml-lang/toml repository alongside the in-development spec text and changelog. There is no standards-body version; the MIME type application/toml was registered with IANA.",
  "0": "No reference implementation: toml-lang/toml-test is the official language-agnostic conformance suite (valid/invalid cases with JSON expected output for decoders and encoders). Level 0 samples many independent parsers (CPython tomllib/tomli, BurntSushi/toml, go-toml, toml-rs, toml++, toml11, tomlkit, smol-toml, Tomlyn, tomlj).",
  "3": "No Rosetta Code category."
 },
