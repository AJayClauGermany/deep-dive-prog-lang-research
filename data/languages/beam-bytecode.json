   "id": "elixir",
   "relation": "host-of"
  }
 ],
 "level_notes": {
  "1": "There is no official specification; the generic instruction set is defined by genop.tab in OTP and the loader-specific forms by ops.tab files. The 1997 instruction-set note is historical.",
  "0": "ERTS in erlang/otp is the only production implementation."
 },
