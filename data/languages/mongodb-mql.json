  "reference-implementation"
 ],
 "homepage": "https://www.mongodb.com/docs/manual/reference/mql/",
 "level_notes": {
  "1": "No standard; the MongoDB manual is the definition. FerretDB, Amazon DocumentDB and Azure Cosmos DB implement compatible subsets."
 },
