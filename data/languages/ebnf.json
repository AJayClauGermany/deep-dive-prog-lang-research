  "Roger S. Scowen (ISO 14977 editor)"
 ],
 "summary": "Family of metalanguages extending BNF with optional ([ ]), repetition ({ }) and grouping constructs. ISO/IEC 14977:1996 standardised one dialect; the W3C XML spec defined a regex-flavoured dialect (?, *, +, character classes) reused across W3C languages; many language specifications use their own variant.",
 "status": "active",
 "defined_by": [
  "international-standard",
  "consortium-standard",
  "academic-paper"
 ],
 "standards": [
  "ISO/IEC 14977:1996",
  "W3C XML 1.0 §6 Notation"
 ],
