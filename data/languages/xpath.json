  "Michael Kay"
 ],
 "summary": "W3C expression language for addressing and computing over XML trees: location paths with axes and predicates, grown in 2.0-3.1 into a functional language over sequences with types from XML Schema, higher-order functions, maps, arrays and JSON support.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C XPath 1.0 (1999)",
  "W3C XPath 2.0 (2007/2010)",
  "W3C XPath 3.1 (2017)"
 ],
