  "Jean-Raymond Abrial",
  "Bernard Sufrin",
  "J. Michael Spivey",
  "Oxford Programming Research Group"
 ],
 "summary": "Model-based formal specification notation from the Oxford Programming Research Group, built on typed Zermelo-Fraenkel set theory and first-order predicate logic, with schemas and a schema calculus for structuring specifications of states and operations. Standardised as ISO/IEC 13568:2002.",
 "status": "maintained",
 "defined_by": [
  "international-standard",
  "academic-paper"
 ],
 "standards": [
  "ISO/IEC 13568:2002"
 ],
