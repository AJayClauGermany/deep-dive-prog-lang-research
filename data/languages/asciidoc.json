  "Stuart Rackham",
  "Dan Allen (Asciidoctor)"
 ],
 "summary": "A plain-text markup language for technical documentation, semantically equivalent to DocBook: sections, delimited blocks, tables, cross references, document attributes (variables), macros and a preprocessor with include and conditional directives. Being standardised by the Eclipse AsciiDoc Working Group.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "community-specification"
 ],
