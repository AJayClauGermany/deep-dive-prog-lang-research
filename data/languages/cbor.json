{
 "id": "cbor",
 "name": "CBOR",
 "aliases": [
  "Concise Binary Object Representation"
 ],
 "categories": [
  "data-serialization"
 ],
 "paradigms": [
  "declarative",
  "data"
 ],
 "typing": [
  "dynamic",
  "self-describing",
  "tagged"
 ],
 "first_appeared": 2013,
 "designers": [
  "Carsten Bormann",
  "Paul Hoffman"
 ],
 "summary": "IETF binary data format modelled on the JSON data model plus byte strings, tags and simple values; designed for small code size, small messages and extensibility without version negotiation. Used by COSE, CWT, WebAuthn and CoAP.",
 "status": "active",
 "defined_by": [
  "international-standard"
 ],
 "standards": [
  "RFC 8949 (STD 94)",
  "RFC 7049 (obsoleted)",
  "RFC 8610 (CDDL)"
 ],
 "file_extensions": [
  ".cbor"
 ],
 "homepage": "https://cbor.io/",
 "influenced_by": [
  "json",
  "messagepack"
 ],
 "related": [
  {
   "id": "json",
   "relation": "family"
  },
  {
   "id": "messagepack",
   "relation": "variant-of"
  },
  {
   "id": "cddl",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "RFC 8949 (Internet Standard STD 94) is normative and obsoletes RFC 7049; RFC 8610 defines CDDL, the schema notation commonly used with CBOR; the IANA tag registry extends the data model.",
  "0": "No reference implementation; tinycbor (Intel), fxamacker/cbor (Go) and many others implement the RFC; the cbor/test-vectors repository mirrors RFC Appendix A as JSON for conformance testing."
 },
