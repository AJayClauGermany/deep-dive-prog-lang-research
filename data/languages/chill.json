  "algol-68",
  "pascal"
 ],
 "level_notes": {
  "1": "ITU-T Recommendation Z.200 (1980, 1984, 1988, 1992, 1996, 1999/CHILL2000) is the definition; ITU makes older recommendations available from its recommendation page (some editions free).",
  "0": "GNU CHILL front end shipped with GCC 2.8-2.95 (Cygnus) and was removed afterwards; its texinfo sources survive in GCC history mirrors."
 },
