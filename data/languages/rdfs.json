 "first_appeared": 1998,
 "designers": [
  "Dan Brickley",
  "R. V. Guha",
  "Brian McBride"
 ],
 "summary": "Semantic extension of RDF providing a minimal vocabulary for describing vocabularies: rdfs:Class, rdf:Property, rdfs:subClassOf, rdfs:subPropertyOf, rdfs:domain, rdfs:range, labels, comments, containers and collections. Its model-theoretic RDFS entailment derives new triples rather than validating data.",
 "status": "active",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C RDF Schema 1.1 (2014)",
  "W3C RDF Schema 1.2 (draft)",
  "W3C RDF Vocabulary Description Language 1.0 (2004)"
 ],
 "file_extensions": [
  ".ttl",
  ".rdf"
 ],
 "homepage": "https://www.w3.org/TR/rdf-schema/",
 "influenced_by": [
  "rdf"
 ],
 "related": [
  {
   "id": "rdf",
   "relation": "family"
  },
  {
   "id": "owl",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "The vocabulary is defined in 'RDF Schema 1.1'; its formal meaning (RDFS interpretations and entailment rules) lives in 'RDF 1.1 Semantics' sections 9 and A. The machine-readable vocabulary is published at the namespace IRI.",
  "0": "RDFS reasoners: Apache Jena's rule reasoner (rdfs.rules), RDFLib's OWL-RL package (RDFSClosure), RDF4J's schema-caching inferencer."
 },
