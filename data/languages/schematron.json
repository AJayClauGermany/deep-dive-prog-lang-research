 ],
 "summary": "Rule-based XML validation language: patterns contain rules whose XPath context selects nodes and whose assert/report elements state natural-language-documented XPath conditions; phases, abstract patterns, variables and diagnostics are supported, and reports are produced in SVRL. Usually implemented by compiling the schema to XSLT.",
 "status": "maintained",
 "defined_by": [
  "international-standard"
 ],
 "standards": [
  "ISO/IEC 19757-3:2006",
  "ISO/IEC 19757-3:2016",
