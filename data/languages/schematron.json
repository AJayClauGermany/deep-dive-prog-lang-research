 ],
 "level_notes": {
  "1": "Defined by ISO/IEC 19757-3 (DSDL Part 3); the 2016 edition is freely downloadable from ISO's Publicly Available Standards page (zip). Pre-ISO Schematron 1.5 was Rick Jelliffe's own specification.",
  "0": "The original 'skeleton' XSLT implementation (Schematron/schematron, archived 2020) compiles schemas to XSLT; SchXslt (now on Codeberg) is its recommended successor."
 },
