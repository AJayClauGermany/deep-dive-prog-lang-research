 ],
 "first_appeared": 1993,
 "designers": [
  "Microsoft"
 ],
 "summary": "Microsoft's interface definition language for RPC and COM, extending the DCE RPC IDL with COM interfaces, coclasses, type libraries and Automation attributes; the MIDL compiler generates C/C++ headers, proxy/stub marshalling code and type libraries. MIDL 3.0 is a simplified C#-like syntax for Windows Runtime (WinRT) types.",
 "status": "maintained",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "standards": [
  "DCE 1.1 RPC IDL (The Open Group C706) as base"
 ],
 "file_extensions": [
  ".idl",
  ".acf",
  ".odl"
 ],
 "homepage": "https://learn.microsoft.com/en-us/windows/win32/midl/midl-start-page",
 "influenced_by": [
  "dce-idl",
  "omg-idl",
  "c"
 ],
 "related": [
  {
   "id": "omg-idl",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "Defined by Microsoft's MIDL Language Reference (attribute- and keyword-per-page documentation, no grammar) and, for WinRT, the MIDL 3.0 reference; the underlying DCE RPC IDL is specified in The Open Group's DCE 1.1 RPC specification.",
  "0": "Microsoft's midl.exe is closed source; Wine's widl is an open-source MIDL-compatible compiler (bison grammar)."
 },
