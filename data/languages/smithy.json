{
 "id": "smithy",
 "name": "Smithy",
 "aliases": [
  "Smithy IDL",
  "Smithy 2.0"
 ],
 "categories": [
  "schema-idl"
 ],
 "paradigms": [
  "declarative",
  "resource-oriented"
 ],
 "typing": [
  "static",
  "nominal shapes",
  "traits as typed annotations"
 ],
 "first_appeared": 2019,
 "designers": [
  "Michael Dowling",
  "Amazon Web Services"
 ],
 "summary": "Protocol-agnostic interface definition language from AWS: a model is a graph of shapes (simple types, lists, maps, structures, unions, enums, services, operations, resources) in namespaces, refined by traits (typed annotations) and mixins, with a selector language for querying models and documented breaking-change rules. Used to generate AWS SDKs.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "standards": [
  "Smithy 2.0 specification (2022)",
  "Smithy 1.0"
 ],
 "file_extensions": [
  ".smithy",
  ".json"
 ],
 "homepage": "https://smithy.io/",
 "influenced_by": [
  "omg-idl",
  "json-schema"
 ],
 "related": [
  {
   "id": "typespec",
   "relation": "family"
  },
  {
   "id": "openapi",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "The Smithy 2.0 specification at smithy.io (IDL ABNF, semantic model, prelude, trait catalogue) is normative; models have both an IDL and a JSON AST form.",
  "0": "smithy-lang/smithy (Java) is the reference implementation: IDL loader, validators, selectors and smithy-diff; code generators (smithy-typescript, smithy-rs, ...) build on it."
 },
