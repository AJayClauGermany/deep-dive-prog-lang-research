  "string-valued"
 ],
 "first_appeared": 1972,
 "summary": "Plain-text tabular format of records separated by line breaks and fields separated by commas, with double-quote quoting. In use since the early 1970s; RFC 4180 (2005) documented the common form and registered text/csv, and W3C's CSV on the Web added a model and metadata vocabulary. Dialects (delimiters, quoting, encodings, headers) remain the main interoperability problem.",
 "status": "active",
 "defined_by": [
  "international-standard",
  "informal"
 ],
 "standards": [
  "RFC 4180",
  "RFC 7111",
  "W3C Model for Tabular Data and Metadata on the Web"
 ],
 "file_extensions": [
  ".csv",
  ".tsv"
 ],
 "homepage": "https://www.rfc-editor.org/rfc/rfc4180.html",
 "related": [
  {
   "id": "ndjson",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "RFC 4180 is informational, not a standards-track definition; it documents common practice and registers text/csv. The W3C CSV on the Web recommendations (2015) define a tabular data model, parsing hints and a JSON metadata vocabulary; Frictionless Table Dialect describes dialect parameters.",
  "0": "No reference implementation; widely used parsers (CPython _csv, Go encoding/csv, rust-csv, libcsv, Papa Parse) define their own dialect options."
 },
