{
 "id": "ini",
 "name": "INI files",
 "aliases": [
  "INI",
  ".ini",
  "initialization file",
  "conf/cfg files"
 ],
 "categories": [
  "configuration"
 ],
 "paradigms": [
  "declarative"
 ],
 "typing": [
  "untyped",
  "string-valued"
 ],
 "first_appeared": 1985,
 "designers": [
  "Microsoft (MS-DOS / Windows 1.0)"
 ],
 "summary": "Informal configuration format of [section] headers and key=value lines with ; or # comments, popularised by Windows 1.x/3.x WIN.INI and SYSTEM.INI. Never standardised, so every parser (Windows profile API, Python configparser, Git config, systemd units, PHP, inih) defines its own dialect of quoting, escaping, comments, duplicates and nesting.",
 "status": "maintained",
 "defined_by": [
  "informal",
  "reference-implementation"
 ],
 "file_extensions": [
  ".ini",
  ".cfg",
  ".conf"
 ],
 "homepage": "https://en.wikipedia.org/wiki/INI_file",
 "related": [
  {
   "id": "toml",
   "relation": "family"
  },
  {
   "id": "java-properties",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "No specification. The Windows GetPrivateProfileString/WritePrivateProfileString documentation is the closest to an original definition; Python configparser, git-config, systemd.syntax and the freedesktop Desktop Entry spec each define documented dialects; Cloanto's 'INI file specification' is an unofficial attempt at a common core.",
  "0": "Each implementation is its own dialect definition: CPython configparser, inih, libconfini.",
  "3": "Wikipedia's article includes a comparison of INI parsers."
 },
