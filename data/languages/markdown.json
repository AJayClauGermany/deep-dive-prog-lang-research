 "designers": [
  "John Gruber",
  "Aaron Swartz"
 ],
 "summary": "Lightweight plain-text markup language converted to (X)HTML, designed by John Gruber with Aaron Swartz to be readable as-is. The original dialect is defined only informally by the Daring Fireball syntax page and the Markdown.pl reference implementation; its ambiguities led to many flavours and to CommonMark.",
 "status": "maintained",
 "defined_by": [
  "informal",
  "reference-implementation"
 ],
 "standards": [
  "RFC 7763 (text/markdown media type)",
  "RFC 7764 (guidance on Markdown)"
 ],
 "file_extensions": [
  ".md",
  ".markdown",
  ".mdown",
  ".mkd"
 ],
 "homepage": "https://daringfireball.net/projects/markdown/",
 "influenced_by": [
  "html",
  "textile",
  "restructuredtext"
 ],
 "related": [
  {
   "id": "commonmark",
   "relation": "family"
  },
