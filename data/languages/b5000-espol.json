  "reference-implementation"
 ],
 "influenced_by": [
  "algol-60"
 ],
 "level_notes": {
  "0": "The retro-b5500 project preserves the B5500 ESPOL compiler (written in ALGOL) and MCP sources in ESPOL, and runs them in an emulator.",
  "2": "Secondary literature is limited to Wikipedia and retro-computing project notes.",
  "1": "ESPOL manuals are on bitsavers; NEWP manuals are distributed by Unisys for ClearPath MCP and are not linked here."
 },
