{
 "id": "move",
 "name": "Move",
 "categories": [
  "smart-contract"
 ],
 "paradigms": [
  "imperative",
  "resource-oriented"
 ],
 "typing": [
  "static",
  "strong",
  "linear",
  "inferred-local"
 ],
 "first_appeared": 2019,
 "designers": [
  "Sam Blackshear",
  "Evan Cheng",
  "David L. Dill",
  "Facebook Novi/Diem team"
 ],
 "summary": "Resource-oriented smart-contract language created for Diem: linear 'resource' types with abilities (copy, drop, store, key) prevent duplicating or losing assets, enforced by a bytecode verifier; now used by Sui, Aptos and others, with the Move Prover for formal verification.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "academic-paper",
  "informal"
 ],
 "file_extensions": [
  ".move"
 ],
 "homepage": "https://move-language.github.io/move/",
 "influenced_by": [
  "rust"
 ],
 "related": [
  {
   "id": "solidity",
   "relation": "family"
  }
 ],
 "level_notes": {
  "1": "No formal standard. The original Move book (move-language.github.io/move), the Diem Move white paper and the formal papers (Resources, borrow checker, Robust Safety) define the language; Sui Move (move-book.com reference, Move 2024 edition) and Aptos Move (Move 2) have diverged into dialects with their own references.",
  "0": "move-language/move holds the original compiler, bytecode verifier, VM, stdlib and Move Prover; maintained forks live in MystenLabs/sui (external-crates/move) and aptos-labs/aptos-core (third_party/move, aptos-move)."
 },
