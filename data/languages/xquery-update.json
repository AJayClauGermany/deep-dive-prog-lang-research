{
 "id": "xquery-update",
 "name": "XQuery Update Facility",
 "aliases": [
  "XQUF",
  "XQuery Update"
 ],
 "categories": [
  "query",
  "domain-specific"
 ],
 "paradigms": [
  "declarative",
  "functional"
 ],
 "typing": [
  "static",
  "dynamic",
  "strong"
 ],
 "first_appeared": 2008,
 "designers": [
  "W3C XML Query Working Group",
  "Don Chamberlin",
  "Michael Dyck",
  "Daniela Florescu",
  "Jim Melton",
  "Jonathan Robie",
  "Jérôme Siméon"
 ],
 "summary": "W3C extension of XQuery with updating expressions (insert, delete, replace, rename) and the copy-modify (transform) expression; updates are collected into a pending update list and applied atomically at the end of a snapshot, keeping query evaluation side-effect free.",
 "status": "maintained",
 "defined_by": [
  "consortium-standard"
 ],
 "standards": [
  "W3C XQuery Update Facility 1.0 (2011)",
  "W3C XQuery Update Facility 3.0 (Working Group Note, 2017)"
 ],
 "homepage": "https://www.w3.org/TR/xquery-update-30/",
 "influenced_by": [
  "xquery"
 ],
 "related": [
  {
   "id": "xquery",
   "relation": "superset-of"
  }
 ],
 "level_notes": {
  "1": "XQUF 1.0 is a W3C Recommendation (with formal static typing rules); 3.0 aligns it with XQuery 3.0 and was published as a Working Group Note. www.w3.org returns a Cloudflare 403 to the link checker; anchors were verified with a plain curl fetch.",
  "0": "BaseX implements XQUF 3.0 (updating expressions in up/expr, pending update list in up/Updates.java); Saxon-EE and Zorba also implement it."
 },
