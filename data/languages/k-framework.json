 ],
 "summary": "Rewrite-based executable semantic framework in which a programming language is defined by its syntax (BNF productions with attributes), a configuration of nested cells and rewrite rules; from one definition K derives a parser, interpreter, symbolic executor and a matching-logic deductive verifier. Used for formal semantics of C, Java, EVM and more.",
 "status": "active",
 "defined_by": [
  "reference-implementation",
  "academic-paper"
 ],
