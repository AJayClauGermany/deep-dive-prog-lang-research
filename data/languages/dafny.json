{
 "id": "dafny",
 "name": "Dafny",
 "categories": [
  "general-purpose",
  "proof-assistant",
  "specification-modeling"
 ],
 "paradigms": [
  "imperative",
  "functional",
  "object-oriented"
 ],
 "typing": [
  "static",
  "strong",
  "inferred",
  "refinement-subset-types"
 ],
 "first_appeared": 2009,
 "designers": [
  "K. Rustan M. Leino"
 ],
 "summary": "Verification-aware programming language with built-in pre/postconditions, loop invariants, termination metrics, ghost code and lemmas; programs are verified by translation to Boogie and the Z3 SMT solver and compiled to C#, Java, JavaScript, Go, Python and Rust.",
 "status": "active",
 "defined_by": [
  "vendor-specification",
  "reference-implementation"
 ],
 "file_extensions": [
  ".dfy"
 ],
 "homepage": "https://dafny.org/",
 "influenced_by": [
  "boogie",
  "spec-sharp",
  "eiffel",
  "ml"
 ],
 "related": [
  {
   "id": "boogie",
   "relation": "compiles-to"
  },
  {
   "id": "spec-sharp",
   "relation": "successor-of"
  }
 ],
 "level_notes": {
  "1": "The Dafny Reference Manual (single page, dafny.org/latest) is the de facto specification; there is no standard. Leino's 2010 LPAR paper introduced the language.",
  "0": "Single implementation in dafny-lang/dafny (C#): Coco/R grammar Dafny.atg, resolver/pre-type inference, Boogie generator (verifier) and per-target code generators."
 },
